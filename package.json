{
  "name": "corebi-site",
  "version": "1.0.0",
  "private": true,
  "description": "Site oficial do CoreBi.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
