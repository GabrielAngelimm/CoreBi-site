---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AppTile from "@/components/ui/AppTile.astro";
import Button from "@/components/ui/Button.astro";
---

<BaseLayout title="Página não encontrada · CoreBi">
  <main class="lost">
    <AppTile size="sm" />
    <p class="code num">404</p>
    <h1 class="h2">Essa página não existe.</h1>
    <p class="lead">O link pode estar errado ou a página mudou de lugar.</p>
    <Button href="/" icon="arrowUpRight">
      Voltar para o início
    </Button>
  </main>
</BaseLayout>

<style>
  .lost {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    min-height: 100svh;
    padding: 48px var(--gutter);
    text-align: center;
  }

  .code {
    margin: 18px 0 0;
    color: var(--signal);
    font: 600 18px/1 var(--font-readout);
    letter-spacing: 0.2em;
  }

  .lead {
    margin: 0 0 12px;
  }
</style>
