---
import Section from "@/components/layout/Section.astro";
import BenchmarkTile from "./features/BenchmarkTile.astro";
import NetworkTile from "./features/NetworkTile.astro";
import OverlayTile from "./features/OverlayTile.astro";
import SensorsTile from "./features/SensorsTile.astro";
import StorageTile from "./features/StorageTile.astro";
---

<Section id="recursos" label="recursos-title">
  <div class="wrap">
    <div class="center">
      <h2 id="recursos-title" class="h2">
        Do sensor ao jogo, <span class="soft">tudo numa janela.</span>
      </h2>
      <p class="lead">O que cada parte do app resolve no seu dia a dia.</p>
    </div>
    <div class="bento" data-reveal>
      <SensorsTile />
      <OverlayTile />
      <BenchmarkTile />
      <StorageTile />
      <NetworkTile />
    </div>
  </div>
</Section>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 16px;
    margin-top: 56px;
  }
</style>
