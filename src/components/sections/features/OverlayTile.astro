---
import { features } from "@/data/features";
import FeatureTile from "./FeatureTile.astro";

const rows = [
  ["GPU", "RTX 4060 Ti", "97 %", "66 °C"],
  ["VRAM", "6,1 GB", "76 %", ""],
  ["CPU", "Ryzen 7 5700X", "38 %", "61 °C"],
  ["RAM", "19,6 GB", "62 %", ""],
] as const;

const positions = [
  { id: "tl", label: "Canto superior esquerdo" },
  { id: "tr", label: "Canto superior direito" },
  { id: "bl", label: "Canto inferior esquerdo" },
  { id: "br", label: "Canto inferior direito" },
] as const;
---

<FeatureTile {...features.overlay} icon="gauge" color="var(--signal-hi)" span={5} dark>
  <div slot="head" class="keys" role="group" aria-label="Atalho Ctrl + Shift + O">
    <kbd>Ctrl</kbd>
    <span>+</span>
    <kbd>Shift</kbd>
    <span>+</span>
    <kbd>O</kbd>
  </div>
  <div
    class="scene"
    data-overlay
    role="group"
    aria-label="Exemplo do OverlayBi por cima de um jogo"
  >
    <svg class="land" viewBox="0 0 600 340" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <rect width="600" height="340" fill="#2e3e4c"></rect>
      <circle cx="430" cy="120" r="34" fill="#dce4e8"></circle>
      <polygon
        points="0,220 90,150 160,200 250,120 340,195 420,140 510,200 600,160 600,340 0,340"
        fill="#3d5061"
      ></polygon>
      <polygon
        points="0,260 110,205 200,245 300,190 390,240 490,205 600,245 600,340 0,340"
        fill="#2a3845"
      ></polygon>
      <polygon
        points="0,340 0,290 140,268 280,296 420,272 600,292 600,340"
        fill="#1c2730"
      ></polygon>
      <polygon points="70,292 84,240 98,292" fill="#1c2730"></polygon>
      <polygon points="96,292 112,226 128,292" fill="#1c2730"></polygon>
      <polygon points="500,294 515,236 530,294" fill="#1c2730"></polygon>
    </svg>
    <div class="hud num" data-hud data-pos="tl" aria-hidden="true">
      <div class="fps">
        <b data-fps>144</b>
        <span>FPS</span>
        <span data-frametime>6,9 ms</span>
      </div>
      <table>
        {rows.map((r) => (
          <tr>
            <td>{r[0]}</td>
            <td>{r[1]}</td>
            <td class="v">{r[2]}</td>
            <td class="v">{r[3]}</td>
          </tr>
        ))}
      </table>
    </div>
  </div>
  <div class="positions" role="group" aria-label="Posição do overlay">
    <span>Posição</span>
    {positions.map((p, i) => (
      <button
        type="button"
        data-position={p.id}
        aria-pressed={i === 0 ? "true" : "false"}
        aria-label={p.label}
      >
        <i />
      </button>
    ))}
  </div>
</FeatureTile>

<script>
  import "./overlay";
</script>

<style>
  .keys {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 16px;
    font: 500 13px/1 var(--font-display);
    color: var(--night-faint);
  }

  kbd {
    padding: 7px 10px;
    border: 1px solid var(--night-line);
    border-bottom-width: 2px;
    border-radius: 8px;
    background: var(--night-2);
    font: 600 13px/1 var(--font-display);
    color: var(--night-fg);
  }

  .scene {
    position: relative;
    flex: 1;
    min-height: 250px;
    margin: 24px 24px 16px;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: #2e3e4c;
  }

  .land {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hud {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 10px 13px 11px;
    border-radius: 10px;
    background: rgb(14 18 20 / 92%);
    font: 500 11px/1.3 var(--font-readout);
    color: var(--night-fg);
    transition:
      top 0.45s var(--ease-out),
      left 0.45s var(--ease-out),
      right 0.45s,
      bottom 0.45s;
  }

  .hud[data-pos="tr"] {
    left: auto;
    right: 14px;
  }

  .hud[data-pos="bl"] {
    top: auto;
    bottom: 14px;
  }

  .hud[data-pos="br"] {
    inset: auto 14px 14px auto;
  }

  .fps {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-bottom: 5px;
  }

  .fps b {
    font: 600 28px/1 var(--font-readout);
    color: var(--signal-hi);
  }

  .fps span {
    color: var(--night-muted);
  }

  table {
    border-collapse: collapse;
  }

  td {
    padding: 1.5px 0;
    white-space: nowrap;
  }

  td:first-child {
    padding-right: 10px;
    color: var(--night-faint);
  }

  td.v {
    padding-left: 10px;
    text-align: right;
  }

  .positions {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 24px 24px;
    font: 500 13px/1 var(--font-display);
    color: var(--night-faint);
  }

  .positions span {
    margin-right: 6px;
  }

  .positions button {
    position: relative;
    width: 44px;
    height: 32px;
    padding: 0;
    border: 1px solid var(--night-line);
    border-radius: var(--radius-pill);
    background: transparent;
    cursor: pointer;
  }

  .positions i {
    position: absolute;
    width: 12px;
    height: 8px;
    border-radius: 2px;
    background: var(--night-faint);
  }

  [data-position="tl"] i {
    left: 12px;
    top: 8px;
  }

  [data-position="tr"] i {
    right: 12px;
    top: 8px;
  }

  [data-position="bl"] i {
    left: 12px;
    bottom: 8px;
  }

  [data-position="br"] i {
    right: 12px;
    bottom: 8px;
  }

  .positions button[aria-pressed="true"] {
    border-color: var(--signal-hi);
    background: #10373a;
  }

  .positions button[aria-pressed="true"] i {
    background: var(--signal-hi);
  }

  @media (max-width: 700px) {
    .scene,
    .positions {
      margin-inline: var(--pad);
    }
  }
</style>
