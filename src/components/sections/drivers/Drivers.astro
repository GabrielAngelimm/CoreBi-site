---
import Section from "@/components/layout/Section.astro";
import Bubble from "@/components/ui/Bubble.astro";
import Icon from "@/components/ui/Icon.astro";
import { driverExample as d } from "@/data/drivers";
---

<Section id="drivers" label="drivers-title">
  <div class="wrap duo">
    <div class="text">
      <h2 id="drivers-title" class="h2">
        Driver novo, <span class="soft">sem medo de quebrar.</span>
      </h2>
      <p class="lead">
        Baixa o driver da placa de vídeo direto da NVIDIA ou da AMD e guarda um backup antes de
        instalar. Deu problema? É só restaurar.
      </p>
    </div>

    <div
      class="demo done"
      data-drivers
      role="group"
      aria-label="Exemplo de atualização do driver da placa de vídeo"
    >
      <div class="device">
        <Bubble part="gpu" class="device-icon" />
        <div>
          <b>{d.device}</b>
          <span>Placa de vídeo · {d.vendor}</span>
        </div>
      </div>
      <div class="versions">
        <div class="old">
          <span>Instalado</span>
          <b class="num">{d.installed}</b>
        </div>
        <Icon name="arrowRight" class="arrow" />
        <div class="new">
          <span>Mais recente</span>
          <b class="num">{d.latest}</b>
        </div>
      </div>
      <ol class="steps" data-rail style="--progress: 1">
        {d.steps.map((s) => (
          <li class="done" data-ms={s.ms} data-count={"count" in s ? s.count : undefined}>
            <span class="mark">
              <Icon name="check" />
            </span>
            <div>
              <b>{s.title}</b>
              <em data-detail>{s.detail}</em>
            </div>
          </li>
        ))}
      </ol>
      <button type="button" class="update" data-run>
        Atualizar driver
      </button>
    </div>
  </div>
</Section>

<script>
  import "./drivers.client";
</script>

<style>
  .duo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 96px;
    align-items: center;
  }

  .text {
    order: 2;
  }

  .text .lead {
    max-width: 44ch;
  }

  .demo {
    justify-self: center;
    width: 100%;
    max-width: 600px;
  }

  .device {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .device :global(.device-icon) {
    --s: 52px;
  }

  .device b {
    display: block;
    font: 500 var(--text-xl)/1.2 var(--font-display);
    color: var(--ink);
  }

  .device span {
    font: 500 var(--text-md)/1.3 var(--font-display);
    color: var(--faint);
  }

  .versions {
    display: flex;
    align-items: flex-end;
    gap: 24px;
    margin: 32px 0 32px;
  }

  .versions span {
    display: block;
    margin-bottom: 8px;
    font: 500 var(--text-sm)/1 var(--font-display);
    color: var(--faint);
  }

  .versions b {
    position: relative;
    font: 600 var(--num-2xl)/1 var(--font-readout);
    letter-spacing: -0.01em;
    transition: color 0.5s;
  }

  .versions :global(.arrow) {
    width: 48px;
    height: 24px;
    margin-bottom: 14px;
    stroke-width: 1.6;
    color: var(--tick);
  }

  /* ao terminar: a versão antiga é riscada e a nova acende em verde */
  .old b {
    color: var(--ink);
  }

  .old b::after {
    content: "";
    position: absolute;
    inset: 52% -2px auto;
    height: 3px;
    border-radius: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease-in-out);
  }

  .new b {
    color: var(--soft);
  }

  .done .old b {
    color: var(--soft);
  }

  .done .old b::after {
    transform: none;
  }

  .done .new b {
    color: var(--signal);
  }

  /* uma linha liga os passos e enche de verde conforme eles terminam */
  .steps {
    --step-ms: 0ms;
    position: relative;
    margin: 0 0 32px;
    padding: 0;
    list-style: none;
  }

  .steps::before,
  .steps::after {
    content: "";
    position: absolute;
    top: 33px;
    bottom: 33px;
    left: 21px;
    width: 2px;
    border-radius: 2px;
  }

  .steps::before {
    background: var(--dial-ring);
  }

  .steps::after {
    background: var(--signal-hi);
    transform: scaleY(var(--progress));
    transform-origin: top;
    transition: transform var(--step-ms) linear;
  }

  li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 0;
  }

  .mark {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    z-index: 1;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--paper);
    color: var(--on-ink);
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }

  .mark :global(.icon) {
    width: 18px;
    height: 18px;
    stroke-width: 2.2;
    opacity: 0;
    transform: scale(0.4) rotate(-20deg);
    transition:
      opacity 0.2s,
      transform 0.35s var(--ease-out);
  }

  li.done .mark {
    border-color: var(--signal);
    background: var(--signal);
  }

  li.done .mark :global(.icon) {
    opacity: 1;
    transform: none;
  }

  li.busy .mark::after {
    content: "";
    position: absolute;
    inset: -4px;
    border: 2px solid transparent;
    border-top-color: var(--signal-hi);
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
  }

  li b {
    display: block;
    font: 500 var(--text-lg)/1.25 var(--font-display);
    color: var(--muted);
    transition: color 0.2s;
  }

  li.done b,
  li.busy b {
    color: var(--ink);
  }

  li em {
    font: 500 var(--text-md)/1.3 var(--font-display);
    font-style: normal;
    font-variant-numeric: tabular-nums;
    color: var(--faint);
  }

  .update {
    height: 46px;
    padding: 0 24px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--on-ink);
    font: 500 var(--text-md)/1 var(--font-display);
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .update:disabled {
    background: var(--line-2);
    color: var(--muted);
    cursor: default;
  }

  .done .update:disabled {
    background: color-mix(in srgb, var(--signal) 10%, transparent);
    color: var(--signal);
  }

  @media (max-width: 980px) {
    .duo {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .text {
      order: 0;
    }
  }

  @media (max-width: 700px) {
    .duo {
      gap: 48px;
    }
  }

  @media (max-width: 560px) {
    .versions {
      gap: 14px;
      margin: 24px 0 24px;
    }

    .versions b {
      font-size: var(--num-lg);
    }

    .versions :global(.arrow) {
      width: 34px;
    }
  }
</style>
