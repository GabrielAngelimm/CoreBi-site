---
import RunButton from "@/components/ui/RunButton.astro";
import { features } from "@/data/features";
import { GAUGE_END, GAUGE_START, arcPath, ticks } from "@/lib/geometry";
import FeatureTile from "@/components/ui/FeatureTile.astro";

interface Props {
  class?: string;
}

// Resultado de exemplo: o "depois" é 12,6 % mais rápido que o "antes".
const before = 3420;
const after = 3850;
const top = 4500;

const scaleTicks = ticks({
  from: GAUGE_START,
  to: GAUGE_END,
  count: 31,
  radius: 100,
  length: 6,
  majorLength: 10,
  majorEvery: 5,
});
const outer = arcPath(GAUGE_START, GAUGE_END, 78);
const inner = arcPath(GAUGE_START, GAUGE_END, 62);
const fill = (score: number) => `${((score / top) * 100).toFixed(1)} 100`;
---

<FeatureTile {...features.benchmark} part="gpu" icon="gauge" class={Astro.props.class} dark>
  <div class="gauge" data-bench data-before={before} data-after={after} data-top={top}>
    <svg viewBox="-110 -110 220 220" aria-hidden="true">
      <g class="ticks">
        {scaleTicks.map((d) => (
          <path d={d} />
        ))}
      </g>
      <path class="track" d={outer}></path>
      <path class="before" d={outer} pathLength="100" stroke-dasharray={fill(before)}></path>
      <path class="track" d={inner}></path>
      <path class="after" d={inner} pathLength="100" stroke-dasharray={fill(after)} data-arc></path>
    </svg>
    <div class="center">
      <div>
        <b class="num" data-gain>
          +12,6
        </b>
        <small>%</small>
      </div>
      <span data-state>mais rápido</span>
    </div>
  </div>
  <div class="legend">
    <div>
      <i class="dot-before"></i>
      <span>Antes</span>
      <b class="num">3.420</b>
    </div>
    <div>
      <i class="dot-after"></i>
      <span>Depois</span>
      <b class="num" data-score>
        3.850
      </b>
    </div>
    <RunButton data-run>Rodar</RunButton>
  </div>
</FeatureTile>

<script>
  import "./benchmark.client";
</script>

<style>
  .gauge {
    position: relative;
    width: 212px;
    height: 212px;
    margin: 22px auto 0;
  }

  svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  path {
    fill: none;
    stroke-linecap: round;
  }

  .ticks path {
    stroke: var(--night-line);
    stroke-width: 1.2;
  }

  .track {
    stroke: color-mix(in srgb, var(--night-fg) 7%, transparent);
    stroke-width: 9;
  }

  .before {
    stroke: var(--night-faint);
    stroke-width: 9;
  }

  .after {
    stroke: var(--gpu);
    stroke-width: 9;
  }

  .center {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding-top: 6px;
  }

  .center b {
    font: 600 40px/1 var(--font-readout);
    color: var(--night-fg);
  }

  .center small {
    margin-left: 2px;
    font: 500 16px/1 var(--font-display);
    color: var(--night-muted);
  }

  .center span {
    font: 500 13px/1 var(--font-display);
    color: var(--night-muted);
  }

  .legend {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: auto;
    padding: 6px var(--pad) 28px;
  }

  .legend div {
    display: grid;
    grid-template-columns: auto auto;
    align-items: center;
    column-gap: 7px;
  }

  .legend i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  .dot-before {
    background: var(--night-faint);
  }

  .dot-after {
    background: var(--gpu);
  }

  .legend span {
    font: 500 12.5px/1 var(--font-display);
    color: var(--night-muted);
  }

  .legend b {
    grid-column: 2;
    font: 600 22px/1.2 var(--font-readout);
    color: var(--night-fg);
  }

  .legend :global(.run) {
    margin-left: auto;
    background: var(--night-fg);
    color: var(--night);
  }

  .legend :global(.run:disabled) {
    background: var(--night-line);
    color: var(--night-muted);
  }
</style>
