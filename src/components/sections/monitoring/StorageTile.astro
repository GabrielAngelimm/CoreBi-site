---
import { features } from "@/data/features";
import FeatureTile from "@/components/ui/FeatureTile.astro";
import TileStats from "@/components/ui/TileStats.astro";

interface Props {
  class?: string;
}

const life = 97;
const path = "M30 140 A80 80 0 1 1 170 140";
---

<FeatureTile {...features.storage} class={Astro.props.class}>
  <div class="gauge" data-storage>
    <svg viewBox="0 0 200 160" role="img" aria-label={`Vida útil de ${life} %`}>
      <defs>
        <mask id="storage-life" maskUnits="userSpaceOnUse">
          <path class="reach" d={path} pathLength="100" style={`--reach:${life} 100`}></path>
        </mask>
      </defs>
      <path class="track" d={path}></path>
      <path class="value" d={path} mask="url(#storage-life)"></path>
      <text x="100" y="112" class="big">
        <tspan data-life>{life}</tspan>
        <tspan dx="3" class="unit">
          %
        </tspan>
      </text>
      <text x="100" y="136" class="caption">
        vida útil restante
      </text>
    </svg>
  </div>
  <TileStats
    slot="foot"
    items={[
      { label: "Já escrito", value: "18,4", unit: "TB", hook: "written" },
      { label: "Temperatura", value: "41", unit: "°C", hook: "temp" },
    ]}
  />
</FeatureTile>

<script>
  import "./storage.client";
</script>

<style>
  .gauge {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    height: calc(var(--visual-h) + 24px);
    margin: auto var(--pad) 24px;
    padding-top: 24px;
  }

  svg {
    width: auto;
    height: 100%;
  }

  path {
    fill: none;
    stroke-width: 14;
    stroke-dasharray: 3 3;
  }

  .track {
    stroke: var(--line);
  }

  .value {
    stroke: var(--storage);
  }

  /* a máscara corta os segmentos azuis na vida útil restante */
  .reach {
    stroke: #fff;
    stroke-width: 20;
    stroke-dasharray: var(--reach);
  }

  /* ao aparecer, os segmentos acendem do zero até a vida útil, e então param */
  :global(.armed) .reach {
    stroke-dasharray: 0 100;
  }

  :global(.play) .reach {
    animation: reach 1.6s var(--ease-out) both;
  }

  @keyframes reach {
    from {
      stroke-dasharray: 0 100;
    }
  }

  text {
    text-anchor: middle;
  }

  .big {
    font: 600 var(--num-lg) var(--font-readout);
    fill: var(--ink);
  }

  .big .unit {
    font-size: var(--text-xl);
    fill: var(--faint);
  }

  .caption {
    font: 500 var(--text-sm) var(--font-display);
    fill: var(--faint);
  }
</style>
