---
import Section from "@/components/layout/Section.astro";
import Icon from "@/components/ui/Icon.astro";
import { site } from "@/config/site";
import { faq } from "@/data/faq";
import { emphasis } from "@/lib/format";
---

<Section id="perguntas" label="faq-title">
  <div class="wrap layout">
    <header>
      <h2 id="faq-title" class="h2">
        Perguntas frequentes
      </h2>
      <p class="lead">
        Não achou a resposta?{" "}
        <a href={site.links.issues} target="_blank" rel="noopener">
          Abra uma issue no GitHub
        </a>
        .
      </p>
    </header>

    <div class="list-box" data-faq-box>
      <div class="list" data-faq>
        {faq.map((item, i) => (
          <details open={i === 0}>
            <summary>
              {item.question}
              <span class="toggle" aria-hidden="true">
                <Icon name="plus" />
              </span>
            </summary>
            <div class="answer" data-answer>
              <div class="answer-inner">
                {item.answer.map((paragraph) => (
                  <p set:html={emphasis(paragraph)} />
                ))}
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</Section>

<script>
  import "./faq.client";
</script>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 64px;
    align-items: start;
  }

  header {
    position: sticky;
    top: 110px;
  }

  header a {
    color: var(--signal-text);
    font-weight: 500;
    text-decoration: none;
  }

  header a:hover {
    text-decoration: underline;
  }

  .list {
    border-bottom: 1px solid var(--line);
  }

  details {
    border-top: 1px solid var(--line);
  }

  summary {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 24px 0;
    color: var(--ink);
    font: 500 var(--text-xl)/1.3 var(--font-display);
    list-style: none;
    cursor: pointer;
    transition: color 0.2s;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--signal);
  }

  summary:focus-visible {
    outline: 2px solid var(--signal-hi);
    outline-offset: 4px;
    border-radius: 6px;
  }

  .toggle {
    display: grid;
    flex: none;
    place-items: center;
    width: 32px;
    height: 32px;
    margin-left: auto;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--paper);
    color: var(--muted);
    transition:
      transform 0.35s var(--ease-out),
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s;
  }

  .toggle :global(svg) {
    width: 14px;
    height: 14px;
  }

  details[open] .toggle {
    transform: rotate(45deg);
    border-color: var(--ink);
    background: var(--ink);
    color: var(--on-ink);
  }

  /*
   * A altura anima no .answer, que não tem padding; o respiro fica no .answer-inner.
   * Assim fechar chega a zero de verdade, sem os 24 px que sobravam e pulavam no fim.
   */
  .answer {
    overflow: hidden;
    color: var(--muted);
    font-size: var(--text-base);
  }

  .answer-inner {
    padding: 0 48px 24px 0;
  }

  .answer p {
    margin: 0 0 10px;
  }

  .answer p:last-child {
    margin: 0;
  }

  .answer :global(b) {
    color: var(--ink);
    font-weight: 500;
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    header {
      position: static;
    }
  }

  @media (max-width: 560px) {
    summary {
      font-size: var(--text-lg);
    }

    .answer-inner {
      padding-right: 0;
    }
  }
</style>
