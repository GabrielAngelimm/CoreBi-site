---
import Section from "@/components/layout/Section.astro";
import Icon from "@/components/ui/Icon.astro";
import { site } from "@/config/site";
import { faq } from "@/data/faq";
import { emphasis } from "@/lib/format";
---

<Section id="perguntas" label="faq-title" space="roomy">
  <div class="wrap layout">
    <header>
      <h2 id="faq-title" class="h2">
        Perguntas frequentes
      </h2>
      <p class="lead">
        Não achou a resposta?{" "}
        <a href={site.links.issues} target="_blank" rel="noopener">
          Abra uma issue no GitHub
        </a>
        .
      </p>
    </header>

    <div class="list" data-faq data-reveal>
      {faq.map((item, i) => (
        <details open={i === 0}>
          <summary>
            {item.question}
            <span class="toggle" aria-hidden="true">
              <Icon name="plus" />
            </span>
          </summary>
          <div class="answer" data-answer>
            {item.answer.map((paragraph) => (
              <p set:html={emphasis(paragraph)} />
            ))}
          </div>
        </details>
      ))}
    </div>
  </div>
</Section>

<script>
  import "./faq.client";
</script>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 72px;
    align-items: start;
  }

  header {
    position: sticky;
    top: 110px;
  }

  header a {
    color: var(--signal-text);
    font-weight: 500;
    text-decoration: none;
  }

  header a:hover {
    text-decoration: underline;
  }

  .list {
    border-bottom: 1px solid var(--line);
  }

  details {
    border-top: 1px solid var(--line);
  }

  summary {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 24px 0;
    color: var(--ink);
    font: 600 19px/1.3 var(--font-display);
    list-style: none;
    cursor: pointer;
    transition: color 0.2s;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--signal);
  }

  summary:focus-visible {
    outline: 2px solid var(--signal-hi);
    outline-offset: 4px;
    border-radius: 6px;
  }

  .toggle {
    display: grid;
    flex: none;
    place-items: center;
    width: 32px;
    height: 32px;
    margin-left: auto;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--paper);
    color: var(--muted);
    transition:
      transform 0.35s var(--ease-out),
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s;
  }

  .toggle :global(svg) {
    width: 14px;
    height: 14px;
  }

  details[open] .toggle {
    transform: rotate(45deg);
    border-color: var(--ink);
    background: var(--ink);
    color: var(--on-ink);
  }

  .answer {
    overflow: hidden;
    padding: 0 56px 26px 0;
    color: var(--muted);
    font-size: 15.5px;
  }

  .answer p {
    margin: 0 0 10px;
  }

  .answer p:last-child {
    margin: 0;
  }

  .answer :global(b) {
    color: var(--ink);
    font-weight: 500;
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    header {
      position: static;
    }
  }

  @media (max-width: 560px) {
    summary {
      font-size: 17px;
    }

    .answer {
      padding-right: 0;
    }
  }
</style>
