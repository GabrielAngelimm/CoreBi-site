---
/**
 * A última tela: uma segunda abertura, escura. Texto e botões à esquerda, o símbolo do
 * CoreBi gigante em traço à direita e, embaixo, uma faixa com leituras passando.
 */
import SiteFooter from "@/components/layout/SiteFooter.astro";
import Button from "@/components/ui/Button.astro";
import { site } from "@/config/site";
import { readings } from "@/data/final";
import { parts } from "@/data/parts";
import { formatSize, shortHash } from "@/lib/format";
import type { Release } from "@/lib/release";

interface Props {
  release: Release;
}

const { release } = Astro.props;
const { installer } = release;
const facts = ["Grátis", "Código aberto, licença MIT", "Sem conta e sem anúncio"];
---

<section id="baixar" class="final" data-tone="dark" aria-labelledby="final-title">
  <div class="backdrop" aria-hidden="true">
    <svg class="mark" viewBox="0 0 256 256">
      <polygon
        class="frame"
        points="141,35 81,35 34,82 34,174 81,221 141,221 141,195 93,195 60,162 60,94 93,61 141,61"
      ></polygon>
      <polygon
        class="frame"
        points="155,35 184,35 218,69 218,108 202,124 222,144 222,185 186,221 155,221 155,195 175,195 196,174 196,156 178,138 155,138 155,112 177,112 192,97 192,81 173,61 155,61"
      ></polygon>
      <polygon class="core" points="95,84 117,84 117,106 95,106"></polygon>
      <polygon class="core" points="95,121 117,121 117,172 95,172"></polygon>
    </svg>
  </div>

  <div class="wrap content" data-reveal>
    <p class="eyebrow">
      <span class="led"></span>
      Versão {release.version} · Windows 10 e 11
    </p>
    <h2 id="final-title" class="title">
      Abra uma vez <span class="soft">e veja o seu PC por inteiro.</span>
    </h2>
    <div class="actions">
      <Button href={installer.url} variant="light" icon="download">
        Baixar para Windows · {formatSize(installer.sizeBytes)}
      </Button>
      <Button href={site.links.code} variant="ghost" icon="githubSolid" external>
        Ver o código
      </Button>
    </div>
    <ul class="facts">
      {facts.map((f) => (
        <li>{f}</li>
      ))}
      {installer.sha256 && <li class="num">SHA256 {shortHash(installer.sha256)}</li>}
    </ul>
  </div>

  <div class="ticker" aria-hidden="true">
    <div class="track">
      {[0, 1].map(() => (
        <ul>
          {readings.map((r) => (
            <li style={`--c:${parts[r.part].color}`}>
              <i />
              <span>{r.label}</span>
              <b class="num">{r.value}</b>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>

  <SiteFooter tone="dark" />
</section>

<style>
  .final {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100svh;
    padding-top: var(--header-space);
    overflow: hidden;
    isolation: isolate;
    background: var(--night);
    color: var(--night-fg);
    scroll-snap-align: start;
  }

  /* luzes frias e quentes no fundo, e uma grade fina que some nas bordas */
  .final::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(
        ellipse 45% 55% at 12% 18%,
        color-mix(in srgb, var(--signal-hi) 16%, transparent),
        transparent 70%
      ),
      radial-gradient(
        ellipse 40% 45% at 88% 86%,
        color-mix(in srgb, var(--gpu) 12%, transparent),
        transparent 70%
      );
  }

  .final::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(color-mix(in srgb, var(--night-fg) 5%, transparent) 1px, transparent 1px),
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--night-fg) 5%, transparent) 1px,
        transparent 1px
      );
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 70% 60% at 60% 45%, #000 20%, transparent 75%);
    pointer-events: none;
  }

  /* o símbolo gigante, só em traço, desenhando-se devagar */
  .backdrop {
    position: absolute;
    top: 50%;
    right: max(-6vw, -120px);
    z-index: -1;
    width: min(64vw, 900px, 88svh);
    translate: 0 -54%;
    pointer-events: none;
  }

  .mark {
    width: 100%;
    overflow: visible;
  }

  .mark polygon {
    fill: none;
    stroke-width: 0.6;
    stroke-linejoin: round;
  }

  .frame {
    stroke: color-mix(in srgb, var(--night-fg) 22%, transparent);
    stroke-dasharray: 900;
    animation: draw 3.2s var(--ease-out) both;
  }

  .core {
    fill: color-mix(in srgb, var(--signal-hi) 12%, transparent) !important;
    stroke: var(--signal-hi);
    stroke-width: 0.8 !important;
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--signal-hi) 60%, transparent));
    animation: glow 4s ease-in-out infinite;
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 900;
    }
  }

  @keyframes glow {
    50% {
      opacity: 0.55;
    }
  }

  .content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 24px 48px;
    zoom: var(--fit);
  }

  .eyebrow {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 10px;
    margin: 0 0 28px;
    padding: 8px 14px;
    border: 1px solid color-mix(in srgb, var(--night-fg) 14%, transparent);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--night-fg) 5%, transparent);
    font: 500 14px/1 var(--font-display);
    color: var(--night-muted);
  }

  .led {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--signal-hi);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--signal-hi) 20%, transparent);
    animation: blink 2.4s ease-in-out infinite;
  }

  .title {
    max-width: 12ch;
    margin: 0;
    font: 600 clamp(48px, 6.4vw, 104px) / 0.96 var(--font-display);
    letter-spacing: -0.035em;
    color: var(--night-fg);
  }

  .title .soft {
    display: block;
    color: var(--night-soft);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 44px;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 26px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    font: 500 14px/1.3 var(--font-display);
    color: var(--night-faint);
  }

  .facts li {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .facts li + li::before {
    content: "";
    width: 4px;
    height: 4px;
    margin-left: -16px;
    border-radius: 50%;
    background: var(--night-line);
  }

  /* faixa de leituras correndo, como o painel do app */
  .ticker {
    border-block: 1px solid var(--night-line);
    background: color-mix(in srgb, var(--night-2) 70%, transparent);
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .track {
    display: flex;
    width: max-content;
    animation: ticker 48s linear infinite;
  }

  .ticker ul {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ticker li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 18px 34px;
    border-right: 1px solid var(--night-line);
    white-space: nowrap;
  }

  .ticker i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 10px var(--c);
  }

  .ticker span {
    font: 500 14px/1 var(--font-display);
    color: var(--night-muted);
  }

  .ticker b {
    font: 600 17px/1 var(--font-readout);
    color: var(--night-fg);
  }

  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 900px), (max-height: 639px) {
    .final {
      min-height: 0;
      padding-top: 120px;
    }

    .content {
      padding-bottom: 88px;
    }

    .backdrop {
      top: 36px;
      right: -30vw;
      width: 90vw;
      translate: none;
      opacity: 0.6;
    }
  }

  @media (max-width: 560px) {
    .actions {
      flex-direction: column;
      align-items: stretch;
    }

    .actions :global(.btn) {
      justify-content: center;
    }

    .facts {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px 16px;
    }

    .facts li + li::before {
      display: none;
    }

    .ticker li {
      padding: 14px 22px;
    }
  }
</style>
