---
/**
 * A última tela: uma segunda abertura, escura. Título e botões à esquerda, o símbolo do
 * CoreBi gigante em traço à direita e, embaixo, uma faixa com leituras ao vivo passando.
 */
import SiteFooter from "@/components/layout/SiteFooter.astro";
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import { site } from "@/config/site";
import { readings } from "@/data/final";
import { parts } from "@/data/parts";
import { decimal, formatSize } from "@/lib/format";
import type { Release } from "@/lib/release";

interface Props {
  release: Release;
}

const { release } = Astro.props;
const { installer } = release;
---

<section id="baixar" class="final" data-tone="dark" aria-labelledby="final-title">
  <div class="backdrop" aria-hidden="true">
    <svg class="mark" viewBox="0 0 256 256">
      <polygon
        class="frame"
        points="141,35 81,35 34,82 34,174 81,221 141,221 141,195 93,195 60,162 60,94 93,61 141,61"
      ></polygon>
      <polygon
        class="frame"
        points="155,35 184,35 218,69 218,108 202,124 222,144 222,185 186,221 155,221 155,195 175,195 196,174 196,156 178,138 155,138 155,112 177,112 192,97 192,81 173,61 155,61"
      ></polygon>
      <polygon class="core" points="95,84 117,84 117,106 95,106"></polygon>
      <polygon class="core" points="95,121 117,121 117,172 95,172"></polygon>
    </svg>
  </div>

  <div class="wrap content">
    <h2 id="final-title" class="title">
      Abra uma vez <span class="soft">e veja o seu PC por inteiro.</span>
    </h2>
    <div class="actions">
      <Button href={installer.url} variant="light" icon="download">
        Baixar para Windows · {formatSize(installer.sizeBytes)}
      </Button>
      <Button href={site.links.code} variant="ghost" icon="githubSolid" external>
        Ver o código
      </Button>
    </div>
  </div>

  <div class="ticker" aria-hidden="true" data-ticker>
    <div class="track">
      {[0, 1].map(() => (
        <ul>
          {readings.map((r) => (
            <li style={`--c:${parts[r.part].color}`}>
              <Icon name={parts[r.part].icon} />
              <span class="label">{r.label}</span>
              {r.live ? (
                <span class="value">
                  <b
                    class="num"
                    data-min={r.live.min}
                    data-max={r.live.max}
                    data-digits={r.live.digits}
                  >
                    {decimal((r.live.min + r.live.max) / 2, r.live.digits)}
                  </b>
                  <small>{r.live.unit}</small>
                </span>
              ) : (
                <span class="value">
                  <b class="num">{r.value}</b>
                </span>
              )}
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>

  <SiteFooter tone="dark" />
</section>

<script>
  import "./final.client";
</script>

<style>
  .final {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100svh;
    padding-top: var(--header-space);
    overflow: hidden;
    isolation: isolate;
    background: var(--night);
    color: var(--night-fg);
    scroll-snap-align: start;
  }

  /* uma grade fina que some nas bordas */
  .final::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(color-mix(in srgb, var(--night-fg) 5%, transparent) 1px, transparent 1px),
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--night-fg) 5%, transparent) 1px,
        transparent 1px
      );
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 70% 60% at 60% 45%, #000 20%, transparent 75%);
    pointer-events: none;
  }

  /* o símbolo gigante, só em traço */
  .backdrop {
    position: absolute;
    top: 50%;
    /* a borda direita do símbolo acompanha a borda do conteúdo (.wrap), sem vazar da tela */
    right: max(24px, (100vw - var(--wrap)) / 2);
    z-index: -1;
    width: min(44vw, 680px, 70svh);
    translate: 0 -54%;
    pointer-events: none;
  }

  .mark {
    width: 100%;
    overflow: visible;
  }

  .mark polygon {
    fill: none;
    stroke-width: 0.6;
    stroke-linejoin: round;
  }

  .frame {
    stroke: color-mix(in srgb, var(--night-fg) 22%, transparent);
  }

  .core {
    fill: color-mix(in srgb, var(--signal-hi) 12%, transparent) !important;
    stroke: var(--signal-hi);
    stroke-width: 0.8 !important;
  }

  .content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 24px 48px;
    zoom: var(--fit);
  }

  /* o rodapé escala junto com o conteúdo, para as bordas baterem */
  .final :global(.footer) {
    zoom: var(--fit);
  }

  .title {
    max-width: 12ch;
    margin: 0;
    font: 500 var(--display-lg) / 0.96 var(--font-display);
    letter-spacing: -0.035em;
    color: var(--night-fg);
  }

  .title .soft {
    display: block;
    color: var(--night-soft);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 48px;
  }

  /* faixa de leituras ao vivo, como o painel do app: ícone na cor da peça, nome e número */
  .ticker {
    border-top: 1px solid var(--night-line);
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }

  .track {
    display: flex;
    width: max-content;
    animation: ticker 64s linear infinite;
  }

  .ticker:hover .track {
    animation-play-state: paused;
  }

  .ticker ul {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ticker li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 24px 48px;
    border-right: 1px solid var(--night-line);
    white-space: nowrap;
  }

  .ticker :global(.icon) {
    width: 22px;
    height: 22px;
    color: var(--c);
  }

  .label {
    font: 500 var(--text-md)/1 var(--font-display);
    color: var(--night-muted);
  }

  .value {
    display: flex;
    align-items: baseline;
    gap: 4px;
  }

  .value b {
    font: 600 var(--text-xl)/1 var(--font-readout);
    color: var(--night-fg);
  }

  .value small {
    font: 500 var(--text-sm)/1 var(--font-display);
    color: var(--night-faint);
  }

  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 900px), (max-height: 639px) {
    .final {
      min-height: 0;
      padding-top: 120px;
    }

    .content {
      padding-bottom: 96px;
    }

    .backdrop {
      top: 36px;
      right: -16vw;
      width: 84vw;
      translate: none;
      opacity: 0.6;
    }
  }

  @media (max-width: 560px) {
    .actions {
      flex-direction: column;
      align-items: stretch;
    }

    .actions :global(.btn) {
      justify-content: center;
    }

    .ticker li {
      padding-block: 16px;
    }
  }
</style>
