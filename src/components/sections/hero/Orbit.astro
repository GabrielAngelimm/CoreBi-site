---
/**
 * O mostrador atrás da abertura: três anéis em volta do ícone do app, cada um girando inteiro
 * com as suas duas peças presas nele, e o vizinho girando ao contrário (anti-horário, horário,
 * anti-horário). O de dentro é o mais colorido, o do meio tem cor média e o de fora é cinza.
 * As bolhas são brancas, só com o ícone e o aro na cor da peça, e ficam sempre em pé.
 */
import Bubble from "@/components/ui/Bubble.astro";
import { orbit, rings, type RingId } from "@/data/hero";

const ids: readonly RingId[] = [1, 2, 3];
const layers = ids.map((id) => ({
  id,
  ...rings[id],
  items: orbit.filter((item) => item.ring === id),
}));

// raio de cada anel no computador (-d) e no celular (-m); o CSS escolhe qual vale em --rN
const radius = (id: RingId) => ({
  [`--r${id}-d`]: `calc(${rings[id].radius} * var(--u))`,
  [`--r${id}-m`]: `${rings[id].mobile}px`,
});
const vars = { ...radius(1), ...radius(2), ...radius(3) };
---

<div class="dial" aria-hidden="true" data-dial style={vars}>
  {layers.map((layer) => (
    <div
      class:list={["layer", `l${layer.id}`, layer.turn]}
      style={{
        "--r": `var(--r${layer.id})`,
        "--t": `${layer.seconds}s`,
        "--b-d": `calc(${layer.bubble} * var(--u))`,
        "--b-m": `${layer.bubbleMobile}px`,
      }}
    >
      {layer.id === 1 && (
        <>
          <span class="ring vivid" />
          <svg class="ticks t1" viewBox="-100 -100 200 200">
            <circle r="98" pathLength="720" class="minor" />
            <circle r="98" pathLength="720" class="major" />
          </svg>
          <span class="sweep s1" />
        </>
      )}
      {layer.id === 2 && (
        <>
          <span class="ring medium" />
          <svg class="ticks" viewBox="-100 -100 200 200">
            <circle r="99.9" pathLength="480" class="dash" />
          </svg>
          <span class="sweep s2" />
        </>
      )}
      {layer.id === 3 && (
        <>
          <span class="ring mono" />
          <svg class="ticks" viewBox="-100 -100 200 200">
            <circle r="99.95" pathLength="900" class="dots" />
          </svg>
        </>
      )}
      {layer.items.map((item, i) => (
        <div
          class="sat"
          style={{
            "--angle": `${item.angle}deg`,
            "--angle-m": `${item.mobileAngle}deg`,
            "--pop": `${0.55 + layer.id * 0.12 + i * 0.08}s`,
          }}
        >
          <Bubble part={item.part} icon={item.icon} class="orb" />
        </div>
      ))}
    </div>
  ))}
</div>

<style>
  /*
   * --u é o "pixel" do mostrador: 1px numa tela de 1920 × 900, menor em telas menores.
   * Tudo no desktop é medido em --u, então o desenho inteiro escala junto, sem JavaScript.
   */
  .dial {
    --u: min(1px, 100vw / 1920, 100vh / 900);
    --cy: 50%;
    --r1: var(--r1-d);
    --r2: var(--r2-d);
    --r3: var(--r3-d);
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  /*
   * Cada anel é uma peça só: a linha, as marcas e as bolhas giram juntas, sem nada
   * escorregando por cima. A entrada abre de dentro para fora; depois a volta é constante.
   */
  .layer {
    --b: var(--b-d);
    position: absolute;
    left: 50%;
    top: var(--cy);
    width: calc(var(--r) * 2);
    aspect-ratio: 1;
    translate: -50% -50%;
    animation:
      turn var(--t) linear infinite,
      open 1.6s var(--ease-out) both;
  }

  .layer.left {
    animation-direction: reverse, normal;
  }

  .l1 {
    animation-delay: 0s, 0.05s;
  }

  .l2 {
    animation-delay: 0s, 0.17s;
  }

  .l3 {
    animation-delay: 0s, 0.29s;
  }

  .ring,
  .sweep {
    position: absolute;
    inset: 0;
    border-radius: 50%;
  }

  /* anel 1: um traço fino com as cores das peças */
  .ring.vivid {
    background: conic-gradient(
      from 20deg,
      var(--cpu),
      var(--signal-hi),
      var(--net),
      var(--gpu),
      var(--memory),
      var(--storage),
      var(--cpu)
    );
    mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 1.5px));
    opacity: 0.55;
  }

  .ring.medium {
    border: 1.5px solid color-mix(in srgb, var(--signal-hi) 26%, var(--dial-tick));
  }

  .ring.mono {
    border: 1px solid var(--dial-line);
  }

  .ticks {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 100%;
    aspect-ratio: 1;
    translate: -50% -50%;
    overflow: visible;
  }

  .ticks circle {
    fill: none;
  }

  /* marcas logo por dentro do anel 1 */
  .t1 {
    width: calc(100% - 36 * var(--u));
  }

  .minor {
    stroke: var(--dial-mark);
    stroke-width: 1.2;
    stroke-dasharray: 0.5 5.5;
  }

  .major {
    stroke: var(--dial-mark);
    stroke-width: 1.8;
    stroke-dasharray: 0.7 59.3;
  }

  /* pontos redondos de uns 4 px em cima da linha do anel 2 */
  .dash {
    stroke: color-mix(in srgb, var(--storage) 55%, var(--dial-tick));
    stroke-width: 0.55;
    stroke-linecap: round;
    stroke-dasharray: 0.01 3.99;
  }

  /* marcas de uns 10 px cruzando a linha do anel 3 */
  .dots {
    stroke: var(--dial-tick);
    stroke-width: 1.1;
    stroke-dasharray: 0.16 2.84;
  }

  /* um trecho mais forte em cada anel colorido, que mostra o giro */
  .sweep {
    border: 2px solid transparent;
  }

  .s1 {
    border-top-color: var(--signal-hi);
  }

  .s2 {
    border-top-color: color-mix(in srgb, var(--storage) 55%, transparent);
  }

  /* peças: do centro do anel, girar até o ângulo, andar o raio e desgirar */
  .sat {
    --a: var(--angle);
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    transform: rotate(var(--a)) translateX(var(--r)) rotate(calc(-1 * var(--a)));
  }

  /*
   * a bolha gira ao contrário do anel, no mesmo tempo, então o ícone nunca tomba;
   * entra depois do anel, com um leve crescimento
   */
  .sat :global(.orb) {
    --s: var(--b);
    position: absolute;
    translate: -50% -50%;
    border: 1.5px solid color-mix(in srgb, var(--c) var(--edge), var(--paper));
    background: var(--paper);
    box-shadow:
      inset 0 0 0 3px var(--paper),
      inset 0 0 0 4px color-mix(in srgb, var(--c) 10%, var(--paper)),
      0 1px 2px color-mix(in srgb, var(--ink) 8%, transparent),
      0 6px 14px -8px color-mix(in srgb, var(--ink) 18%, transparent);
    animation:
      turn var(--t) linear infinite,
      pop 0.9s var(--ease-out) var(--pop) both;
  }

  .right .sat :global(.orb) {
    animation-direction: reverse, normal;
  }

  .sat :global(.orb .icon) {
    width: 44%;
    height: 44%;
  }

  .l1 {
    --edge: 100%;
  }

  .l2 {
    --edge: 90%;
  }

  .l3 {
    --edge: 80%;
  }

  /* fora da abertura, tudo para onde está e continua dali na volta */
  .dial[data-paused] .layer,
  .dial[data-paused] :global(.orb) {
    animation-play-state: paused;
  }

  @keyframes turn {
    to {
      rotate: 360deg;
    }
  }

  @keyframes open {
    from {
      opacity: 0;
      scale: 0.94;
    }
  }

  @keyframes pop {
    from {
      opacity: 0;
      scale: 0.6;
    }
  }

  @media (max-width: 900px) {
    .dial {
      --u: calc(100vw / 1300);
    }
  }

  /* celular: a órbita envolve o ícone do app, no topo, e some antes do título */
  @media (max-width: 560px) {
    .dial {
      --cy: 238px;
      --r1: var(--r1-m);
      --r2: var(--r2-m);
      --r3: var(--r3-m);
      mask-image: linear-gradient(#000 0 262px, transparent 360px);
    }

    .layer {
      --b: var(--b-m);
    }

    .t1 {
      width: calc(100% - 14px);
    }

    .dash {
      stroke-width: 2.4;
    }

    .dots {
      stroke-width: 4;
    }

    .sat {
      --a: var(--angle-m);
    }
  }
</style>
