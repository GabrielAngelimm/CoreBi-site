---
/**
 * O mostrador atrás da abertura: três anéis bem espaçados em volta do ícone do app.
 * O de dentro é o mais colorido, o do meio tem cor média e o de fora é cinza.
 * Cada anel leva uma ou duas peças em posições soltas.
 */
import Bubble from "@/components/ui/Bubble.astro";
import { orbit, rings } from "@/data/hero";
import { decimal } from "@/lib/format";

const items = orbit.map((item) => ({
  ...item,
  tone: rings[item.ring].tone,
  text: item.readout
    ? decimal((item.readout.min + item.readout.max) / 2, item.readout.digits)
    : undefined,
}));

// raio de cada anel no computador (-d) e no celular (-m); o CSS escolhe qual vale em --rN
const radius = (id: 1 | 2 | 3) => ({
  [`--r${id}-d`]: `calc(${rings[id].radius} * var(--u))`,
  [`--r${id}-m`]: `${rings[id].mobile}px`,
});
const vars = { ...radius(1), ...radius(2), ...radius(3) };
---

<div class="dial" aria-hidden="true" data-dial style={vars}>
  <!-- anel 1: colorido, com as marcas finas e um arco que corre -->
  <span class="ring vivid"></span>
  <svg class="ticks t1" viewBox="-100 -100 200 200">
    <circle r="98" pathLength="720" class="minor"></circle>
    <circle r="98" pathLength="720" class="major"></circle>
  </svg>
  <span class="sweep s1"></span>

  <!-- anel 2: cor média, tracejado andando devagar -->
  <span class="ring medium"></span>
  <svg class="ticks t2" viewBox="-100 -100 200 200">
    <circle r="99" pathLength="480" class="dash"></circle>
  </svg>
  <span class="sweep s2"></span>

  <!-- anel 3: só cinza -->
  <span class="ring mono"></span>
  <svg class="ticks t3" viewBox="-100 -100 200 200">
    <circle r="99" pathLength="900" class="dots"></circle>
  </svg>

  {items.map((item, i) => (
    <div
      class="sat"
      style={{
        "--angle": `${item.angle}deg`,
        "--angle-m": `${item.mobileAngle}deg`,
        "--ring": `var(--r${item.ring})`,
        "--float": `${item.float.duration}s`,
        "--delay": `${item.float.delay}s`,
        "--amp": `${-item.float.amplitude}px`,
      }}
    >
      <div class="float">
        <Bubble part={item.part} class={`orb ${item.size} ${item.tone}`}>
          {item.readout && (
            <span class="readout">
              <b
                class="num"
                data-live={i}
                data-min={item.readout.min}
                data-max={item.readout.max}
                data-digits={item.readout.digits}
              >
                {item.text}
              </b>
              <small>{item.readout.unit}</small>
            </span>
          )}
        </Bubble>
      </div>
    </div>
  ))}
</div>

<style>
  /*
   * --u é o "pixel" do mostrador: 1px numa tela de 1920 × 900, menor em telas menores.
   * Tudo no desktop é medido em --u, então o desenho inteiro escala junto, sem JavaScript.
   */
  .dial {
    --u: min(1px, 100vw / 1920, 100vh / 900);
    --cy: 50%;
    --r1: var(--r1-d);
    --r2: var(--r2-d);
    --r3: var(--r3-d);
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  /* tudo parte do centro do mostrador */
  .dial > * {
    position: absolute;
    left: 50%;
    top: var(--cy);
  }

  /* anéis se centralizam pelo próprio tamanho; as peças se centralizam no .float */
  .ring,
  .ticks,
  .sweep {
    translate: -50% -50%;
  }

  .ring,
  .ticks,
  .sweep {
    aspect-ratio: 1;
    border-radius: 50%;
  }

  .vivid,
  .t1,
  .s1 {
    width: calc(var(--r1) * 2);
  }

  .medium,
  .t2,
  .s2 {
    width: calc(var(--r2) * 2);
  }

  .mono,
  .t3 {
    width: calc(var(--r3) * 2);
  }

  /* anel 1: um traço com as cores das peças, girando devagar */
  .ring.vivid {
    background: conic-gradient(
      from 20deg,
      var(--cpu),
      var(--signal-hi),
      var(--net),
      var(--gpu),
      var(--memory),
      var(--storage),
      var(--cpu)
    );
    mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 1.5px));
    opacity: 0.55;
    animation: spin 90s linear infinite;
  }

  .ring.medium {
    border: 1.5px solid color-mix(in srgb, var(--signal-hi) 26%, var(--dial-tick));
  }

  .ring.mono {
    border: 1px solid var(--dial-line);
  }

  .ticks {
    overflow: visible;
  }

  .ticks circle {
    fill: none;
  }

  /* marcas logo por dentro do anel 1 */
  .t1 {
    width: calc(var(--r1) * 2 - 36 * var(--u));
    animation: spin 400s linear infinite;
  }

  .minor {
    stroke: var(--dial-mark);
    stroke-width: 1.2;
    stroke-dasharray: 0.5 5.5;
  }

  .major {
    stroke: var(--dial-mark);
    stroke-width: 1.8;
    stroke-dasharray: 0.7 59.3;
  }

  .dash {
    stroke: color-mix(in srgb, var(--storage) 30%, var(--dial-tick));
    stroke-width: 0.3;
    stroke-dasharray: 0.25 3.75;
    animation: flow 6s linear infinite;
  }

  .t2 {
    width: calc(var(--r2) * 2 + 28 * var(--u));
  }

  .dots {
    stroke: var(--dial-tick);
    stroke-width: 0.5;
    stroke-dasharray: 0.2 2.8;
  }

  .t3 {
    width: calc(var(--r3) * 2 - 30 * var(--u));
    animation: spin 600s linear infinite reverse;
  }

  /* arcos que correm por cima dos anéis 1 e 2 */
  .sweep {
    border: 2px solid transparent;
  }

  .s1 {
    border-top-color: var(--signal-hi);
    animation: spin 26s linear infinite;
  }

  .s2 {
    border-top-color: color-mix(in srgb, var(--storage) 55%, transparent);
    animation: spin 48s linear infinite reverse;
  }

  /* peças: girar até o ângulo, andar o raio e desgirar para o ícone ficar em pé */
  .sat {
    --a: var(--angle);
    width: 0;
    height: 0;
    transform: rotate(var(--a)) translateX(var(--ring)) rotate(calc(-1 * var(--a)));
  }

  .float {
    width: max-content;
    translate: -50% -50%;
    animation: bob var(--float) ease-in-out infinite;
    animation-delay: var(--delay);
  }

  .float :global(.orb) {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: calc(5 * var(--u));
  }

  .float :global(.xl) {
    --s: calc(108 * var(--u));
  }

  .float :global(.md) {
    --s: calc(86 * var(--u));
  }

  .float :global(.sm) {
    --s: calc(58 * var(--u));
  }

  /* anel 1: bolhas cheias na cor da peça */
  .float :global(.vivid) {
    border-color: transparent;
    background: var(--c);
    box-shadow:
      0 1px 0 color-mix(in srgb, #fff 30%, transparent) inset,
      0 18px 38px -14px color-mix(in srgb, var(--c) 70%, transparent);
    color: var(--on-ink);
  }

  /* anel 3: tudo em cinza */
  .float :global(.mono) {
    box-shadow: var(--shadow-sm);
    color: var(--soft);
  }

  .float :global(.orb:has(.readout) .icon) {
    width: 29%;
    height: 29%;
  }

  .readout {
    display: flex;
    align-items: baseline;
    gap: 2px;
  }

  .readout b {
    font: 600 calc(21 * var(--u)) / 1 var(--font-readout);
    color: var(--ink);
  }

  .float :global(.md) .readout b {
    font-size: calc(16 * var(--u));
  }

  .readout small {
    font: 500 calc(10.5 * var(--u)) / 1 var(--font-display);
    color: var(--faint);
  }

  .float :global(.vivid) .readout b,
  .float :global(.vivid) .readout small {
    color: var(--on-ink);
  }

  .float :global(.vivid) .readout small {
    opacity: 0.8;
  }

  @media (max-width: 900px) {
    .dial {
      --u: calc(100vw / 1300);
    }

    .readout {
      display: none;
    }

    .float :global(.orb:has(.readout) .icon) {
      width: 47%;
      height: 47%;
    }
  }

  /* celular: a órbita envolve o ícone do app, no topo, e some antes do título */
  @media (max-width: 560px) {
    .dial {
      --cy: 238px;
      --r1: var(--r1-m);
      --r2: var(--r2-m);
      --r3: var(--r3-m);
      mask-image: linear-gradient(#000 0 262px, transparent 360px);
    }

    .t1 {
      width: calc(var(--r1) * 2 - 14px);
    }

    .t2 {
      width: calc(var(--r2) * 2 + 12px);
    }

    .t3 {
      width: calc(var(--r3) * 2 - 12px);
    }

    .sat {
      --a: var(--angle-m);
    }

    .float :global(.xl) {
      --s: 52px;
    }

    .float :global(.md) {
      --s: 46px;
    }

    .float :global(.sm) {
      --s: 38px;
    }
  }
</style>
