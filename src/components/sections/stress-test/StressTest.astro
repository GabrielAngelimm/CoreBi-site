---
import Section from "@/components/layout/Section.astro";
import Icon from "@/components/ui/Icon.astro";
import RunButton from "@/components/ui/RunButton.astro";
import { parts, type Part } from "@/data/parts";
import {
  GAUGE_END,
  GAUGE_START,
  arcPath,
  gaugeAngle,
  linePath,
  polar,
  ticks,
} from "@/lib/geometry";

// Mostrador de 30 °C a 100 °C, com corte em 85 °C.
const MIN = 30;
const MAX = 100;
const CUT = 85;
const fraction = (t: number) => (t - MIN) / (MAX - MIN);

const scale = ticks({
  from: GAUGE_START,
  to: GAUGE_END,
  count: 71,
  radius: 132,
  length: 6,
  majorLength: 11,
  majorEvery: 7,
});
const labels = [30, 50, 70, 90].map((t) => ({ t, ...polar(gaugeAngle(fraction(t)), 150) }));
const valueArc = arcPath(GAUGE_START, GAUGE_END, 112);
const timeArc = arcPath(GAUGE_START, GAUGE_END, 92);
const cutAngle = gaugeAngle(fraction(CUT));
const cut = linePath(cutAngle, 121, 134);
const cutLabel = polar(cutAngle, 140);

// Estado inicial: um teste de 10 minutos já concluído, sem problemas.
const initial = { temp: 76.9, peak: "77,4" };
const loads: readonly { part: Part; label: string }[] = [
  { part: "cpu", label: "CPU" },
  { part: "memory", label: "RAM" },
  { part: "gpu", label: "GPU" },
];
---

<Section id="teste" label="teste-title">
  <div class="wrap layout">
    <div>
      <h2 id="teste-title" class="h2">
        Seu PC aguenta horas de jogo?
      </h2>
      <p class="lead">
        Deixa o PC no máximo por alguns minutos para achar problemas de calor antes da partida.
      </p>
      <p class="lead">Passou do limite? O teste para sozinho.</p>
    </div>

    <div class="card" data-stress data-min={MIN} data-max={MAX} data-cut={CUT}>
      <header>
        <Icon name="cpu" />
        <div>
          <b>Teste de carga</b>
          <span>Processador · corte em {CUT} °C</span>
        </div>
        <label class="weak">
          Cooler fraco
          <button
            type="button"
            class="switch"
            role="switch"
            aria-checked="false"
            data-weak
          ></button>
        </label>
      </header>

      <div class="body">
        <div class="dial">
          <svg viewBox="-170 -170 340 340" aria-hidden="true">
            <g class="ticks">
              {scale.map((d) => (
                <path d={d} />
              ))}
            </g>
            <g class="labels">
              {labels.map((l) => (
                <text x={l.x} y={l.y + 4}>
                  {l.t}
                </text>
              ))}
            </g>
            <path class="track" d={valueArc}></path>
            <path
              class="value warm"
              d={valueArc}
              pathLength="100"
              stroke-dasharray={`${(fraction(initial.temp) * 100).toFixed(1)} 100`}
              data-value-arc
            ></path>
            <path class="time-track" d={timeArc}></path>
            <path
              class="time"
              d={timeArc}
              pathLength="100"
              stroke-dasharray="100 100"
              data-time-arc
            ></path>
            <path class="cut" d={cut}></path>
          </svg>
          <div class="readout">
            <span>Processador</span>
            <div>
              <b class="num" data-temp>
                76,9
              </b>
              <small>°C</small>
            </div>
            <em>
              <b class="num" data-clock>
                10:00
              </b>{" "}
              de 10:00
            </em>
          </div>
          <div
            class="cut-label"
            style={`left:${((cutLabel.x + 170) / 340) * 100}%;top:${((cutLabel.y + 170) / 340) * 100}%`}
          >
            limite {CUT} °C
          </div>
        </div>

        <div class="loads">
          {loads.map((l) => (
            <span style={`--c:${parts[l.part].color}`}>
              <Icon name={parts[l.part].icon} />
              {l.label} <b class="num">100 %</b>
            </span>
          ))}
          <span class="errors">
            Erros <b class="num">0</b>
          </span>
        </div>

        <p class="message ok" data-message aria-live="polite">
          <i></i>
          <span>Estável por 10 min, sem erros. Máxima de {initial.peak} °C.</span>
        </p>
        <RunButton data-run>Iniciar teste</RunButton>
      </div>
    </div>
  </div>
</Section>

<script>
  import "./stress-test.client";
</script>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 88px;
    align-items: center;
  }

  .card {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper);
    box-shadow: var(--shadow-md);
  }

  header {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 22px 26px;
    border-bottom: 1px solid var(--line);
  }

  header > :global(.icon) {
    width: 40px;
    height: 40px;
    color: var(--cpu);
  }

  header b {
    display: block;
    font: 600 22px/1.1 var(--font-display);
    color: var(--ink);
  }

  header span {
    font-size: 13px;
    color: var(--faint);
  }

  .weak {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
    font: 500 13.5px/1 var(--font-display);
    color: var(--muted);
    cursor: pointer;
  }

  .switch {
    position: relative;
    flex: none;
    width: 44px;
    height: 26px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--line-2);
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .switch::after {
    content: "";
    position: absolute;
    top: 3px;
    left: 3px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--paper);
    box-shadow: 0 1px 3px color-mix(in srgb, var(--ink) 20%, transparent);
    transition: transform 0.2s var(--ease-out);
  }

  .switch[aria-checked="true"] {
    background: var(--signal);
  }

  .switch[aria-checked="true"]::after {
    transform: translateX(18px);
  }

  .body {
    padding: 18px 26px 24px;
  }

  .dial {
    position: relative;
    width: min(400px, 100%);
    aspect-ratio: 1;
    margin: 6px auto 0;
  }

  .dial svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .dial path {
    fill: none;
    stroke-linecap: round;
  }

  .ticks path {
    stroke: var(--dial-tick);
    stroke-width: 1.2;
  }

  .labels text {
    font: 500 11px var(--font-readout);
    fill: var(--faint);
    text-anchor: middle;
  }

  .track {
    stroke: var(--dial-track);
    stroke-width: 12;
  }

  .value {
    stroke: var(--cpu);
    stroke-width: 12;
    transition: stroke 0.4s;
  }

  /* as cores só avançam durante um teste (verde, laranja, vermelho), para não piscar no limite */
  .value.warm {
    stroke: var(--gpu);
  }

  .value.hot {
    stroke: var(--danger);
  }

  .time-track {
    stroke: var(--tick);
    stroke-width: 2;
    stroke-dasharray: 0.1 6;
    opacity: 0.45;
  }

  .time {
    stroke: var(--signal-hi);
    stroke-width: 3;
  }

  .cut {
    stroke: var(--danger);
    stroke-width: 2.5;
  }

  .cut-label {
    position: absolute;
    translate: -10% -50%;
    font: 600 11.5px/1 var(--font-display);
    color: var(--danger);
    white-space: nowrap;
  }

  .readout {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  .readout span,
  .readout em {
    font: 500 13px/1 var(--font-display);
    font-style: normal;
    color: var(--faint);
  }

  .readout div b {
    font: 600 64px/1 var(--font-readout);
    color: var(--ink);
    transition: color 0.3s;
  }

  .readout div b.hot {
    color: var(--danger);
  }

  .readout small {
    margin-left: 3px;
    font: 500 20px/1 var(--font-display);
    color: var(--faint);
  }

  .readout em b {
    font: 600 15px/1 var(--font-readout);
    color: var(--text);
  }

  .loads {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-top: 4px;
  }

  .loads span {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 12px 7px 8px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--paper);
    font: 500 13px/1 var(--font-display);
    color: var(--muted);
  }

  .loads :global(.icon) {
    width: 20px;
    height: 20px;
    color: var(--c);
  }

  .loads b {
    font: 600 13.5px/1 var(--font-readout);
    color: var(--ink);
  }

  .loads .errors {
    padding-left: 12px;
  }

  /* altura fixa: trocar a mensagem nunca empurra o cartão */
  .message {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 46px;
    margin: 16px 0 0;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    background: var(--tint);
    font: 500 14px/1.35 var(--font-display);
    color: var(--text);
  }

  .message i {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--signal-hi);
  }

  .message.ok i {
    background: var(--success);
  }

  .message.stop {
    background: var(--danger-soft);
    color: var(--danger-text);
  }

  .message.stop i {
    background: var(--danger);
  }

  .body :global(.run) {
    margin-top: 16px;
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 44px;
    }
  }

  @media (max-width: 600px) {
    .message {
      min-height: 66px;
    }

    .cut-label {
      display: none;
    }
  }

  @media (max-width: 480px) {
    header {
      flex-wrap: wrap;
    }

    .weak {
      width: 100%;
      margin-left: 0;
    }
  }

  @media (max-width: 700px) {
    .body {
      padding: 16px 20px 20px;
    }
  }
</style>
