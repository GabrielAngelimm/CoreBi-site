---
import { Image } from "astro:assets";
import Section from "@/components/layout/Section.astro";
import Icon from "@/components/ui/Icon.astro";
import Tag from "@/components/ui/Tag.astro";
import { honeycomb, queue } from "@/data/apps";

// Posição de cada app na colmeia: linhas centradas, em colunas de 1/4 da largura.
const widest = Math.max(...honeycomb);
const cells = honeycomb.flatMap((count, row) =>
  Array.from({ length: count }, (_, col) => ({
    x: ((col + 0.5 + (widest - count) / 2) / widest) * 100,
    y: ((row + 0.5) / honeycomb.length) * 100,
  })),
);
const apps = queue.map((app, i) => ({ ...app, ...cells[i] }));
---

<Section id="apps" label="apps-title">
  <div class="wrap duo">
    <div class="text">
      <Tag icon="bag" color="var(--signal)">
        Instalar apps
      </Tag>
      <h2 id="apps-title" class="h2">
        Formatou? <span class="soft">Instale tudo de uma vez.</span>
      </h2>
      <p class="lead">
        Marque os apps e o CoreBi instala um por um, direto da fonte oficial. Sem abrir site e sem
        clicar em Avançar.
      </p>
    </div>

    <div class="demo" data-apps>
      <ul class="hive" aria-label="Exemplo de instalação em fila">
        {apps.map((app) => (
          <li class="done" style={`--x:${app.x}%;--y:${app.y}%;--p:100`}>
            <svg class="progress" viewBox="0 0 100 100" aria-hidden="true">
              <circle cx="50" cy="50" r="47" class="rail" />
              <circle cx="50" cy="50" r="47" class="bar" pathLength="100" />
            </svg>
            <span class="icon-wrap">
              <Image src={app.icon} alt="" width={64} height={64} loading="lazy" />
            </span>
            <span class="ok">
              <Icon name="check" />
            </span>
            <em>{app.name}</em>
          </li>
        ))}
      </ul>
      <p class="count" aria-live="polite">
        <b class="num" data-count>
          {apps.length}
        </b>
        <span>de {apps.length} instalados</span>
      </p>
    </div>
  </div>
</Section>

<script>
  import "./apps";
</script>

<style>
  .duo {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 96px;
    align-items: center;
  }

  .text :global(.tag) {
    margin-bottom: 26px;
  }

  .text .lead {
    max-width: 44ch;
  }

  .demo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 44px;
    width: 100%;
  }

  .hive {
    position: relative;
    width: 100%;
    max-width: 540px;
    aspect-ratio: 1 / 0.8;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    --s: 76px;
    position: absolute;
    left: var(--x);
    top: var(--y);
    translate: -50% -50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    width: var(--s);
  }

  .progress {
    position: absolute;
    left: -6px;
    top: -6px;
    width: calc(var(--s) + 12px);
    height: calc(var(--s) + 12px);
    transform: rotate(-90deg);
    overflow: visible;
  }

  .progress circle {
    fill: none;
    stroke-width: 2.2;
  }

  .rail {
    stroke: transparent;
    transition: stroke 0.3s;
  }

  .bar {
    stroke: var(--signal-hi);
    stroke-linecap: round;
    stroke-dasharray: calc(var(--p, 0) * 1) 100;
    transition:
      stroke-dasharray 0.15s linear,
      opacity 0.4s;
  }

  .icon-wrap {
    display: grid;
    place-items: center;
    width: var(--s);
    height: var(--s);
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--paper);
    box-shadow: var(--shadow-md);
    transition: border-color 0.3s;
  }

  .icon-wrap :global(img) {
    width: 50%;
    height: 50%;
    filter: grayscale(1) opacity(0.45);
    transition: filter 0.5s;
  }

  .ok {
    position: absolute;
    top: -3px;
    right: -3px;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 3px var(--bg);
    color: #fff;
    transform: scale(0);
    transition: transform 0.3s var(--ease-spring);
  }

  .ok :global(.icon) {
    width: 55%;
    height: 55%;
    stroke-width: 2.6;
  }

  em {
    font: 500 13px/1 var(--font-display);
    font-style: normal;
    color: var(--faint);
    white-space: nowrap;
    transition: color 0.3s;
  }

  /* instalando agora */
  li.active .rail {
    stroke: #e3e8eb;
  }

  li.active .icon-wrap :global(img),
  li.done .icon-wrap :global(img) {
    filter: none;
  }

  li.active em,
  li.done em {
    color: var(--ink);
  }

  /* instalado */
  li.done .bar {
    opacity: 0;
  }

  li.done .icon-wrap {
    border-color: rgb(10 133 124 / 28%);
  }

  li.done .ok {
    transform: none;
  }

  .count {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 0;
    padding: 10px 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--paper);
    box-shadow: var(--shadow-sm);
    white-space: nowrap;
  }

  .count b {
    min-width: 1.2ch;
    font: 600 22px/1 var(--font-readout);
    color: var(--ink);
    text-align: right;
  }

  .count span {
    font: 500 14px/1 var(--font-display);
    color: var(--muted);
  }

  @media (max-width: 980px) {
    .duo {
      grid-template-columns: 1fr;
      gap: 56px;
    }
  }

  @media (max-width: 700px) {
    .duo {
      gap: 48px;
    }
  }

  @media (max-width: 560px) {
    .demo {
      gap: 28px;
    }

    .hive {
      aspect-ratio: 1;
    }

    li {
      --s: 58px;
      gap: 10px;
    }

    em {
      font-size: 11.5px;
    }

    .ok {
      width: 20px;
      height: 20px;
    }
  }
</style>
