---
import { icons, type IconName } from "./icons";

interface Props {
  name: IconName;
  class?: string;
  /** Texto para leitores de tela. Sem ele, o ícone é decorativo. */
  label?: string;
}

const { name, class: className, label } = Astro.props;
const viewBox = name === "arrowRight" ? "0 0 48 24" : "0 0 24 24";
---

<svg
  class:list={["icon", className]}
  viewBox={viewBox}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  set:html={icons[name]}
/>

<style>
  .icon {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex: none;
  }

  .icon :global(.dot),
  .icon :global(.solid) {
    fill: currentColor;
    stroke: none;
  }
</style>
