---
import type { HTMLAttributes } from "astro/types";
import Icon from "./Icon.astro";
import type { IconName } from "./icons";

type Props = HTMLAttributes<"a"> & {
  /** ink e line para fundo claro; light e ghost para fundo escuro. */
  variant?: "ink" | "line" | "light" | "ghost";
  size?: "md" | "sm";
  icon?: IconName;
  external?: boolean;
};

const { variant = "ink", size = "md", icon, external, class: className, ...rest } = Astro.props;
const target = external ? { target: "_blank", rel: "noopener" } : {};
---

<a class:list={["btn", variant, size, className]} {...target} {...rest}>
  {icon && <Icon name={icon} />}
  <slot />
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 52px;
    padding: 0 26px;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    font: 600 15px/1 var(--font-display);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 0.15s,
      border-color 0.15s,
      transform 0.15s;
  }

  .btn :global(.icon) {
    width: 18px;
    height: 18px;
  }

  .ink {
    background: var(--ink);
    color: var(--on-ink);
    box-shadow:
      0 1px 0 color-mix(in srgb, var(--paper) 12%, transparent) inset,
      0 6px 16px -6px color-mix(in srgb, var(--ink) 50%, transparent);
  }

  .ink:hover {
    background: var(--ink-2);
    transform: translateY(-1px);
  }

  .line {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--line-2);
    box-shadow: var(--shadow-sm);
  }

  .line:hover {
    border-color: var(--faint);
  }

  .light {
    background: var(--night-fg);
    color: var(--night);
    box-shadow: 0 12px 32px -12px color-mix(in srgb, var(--signal-hi) 45%, transparent);
  }

  .light:hover {
    background: #fff;
    transform: translateY(-1px);
  }

  .ghost {
    border-color: color-mix(in srgb, var(--night-fg) 18%, transparent);
    background: color-mix(in srgb, var(--night-fg) 4%, transparent);
    color: var(--night-fg);
  }

  .ghost:hover {
    border-color: color-mix(in srgb, var(--night-fg) 36%, transparent);
  }

  .sm {
    height: 40px;
    padding: 0 18px;
    font-size: 14px;
  }
</style>
