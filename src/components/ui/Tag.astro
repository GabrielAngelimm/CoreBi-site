---
/** Rótulo de seção: bolha pequena com ícone + nome. */
import { parts, type Part } from "@/data/parts";
import Icon from "./Icon.astro";
import type { IconName } from "./icons";

interface Props {
  part?: Part | undefined;
  icon?: IconName | undefined;
  color?: string | undefined;
  tone?: "light" | "dark";
}

const { part, tone = "light" } = Astro.props;
const icon = Astro.props.icon ?? (part ? parts[part].icon : "cpu");
const color = Astro.props.color ?? (part ? parts[part].color : "var(--signal)");
---

<span class:list={["tag", tone]} style={`--c:${color}`}>
  <span class="mark">
    <Icon name={icon} />
  </span>
  <slot />
</span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: 600 14px/1 var(--font-display);
    color: var(--ink);
  }

  .mark {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--paper);
    box-shadow: var(--shadow-sm);
    color: var(--c);
  }

  .mark :global(.icon) {
    width: 22px;
    height: 22px;
  }

  .dark {
    color: var(--night-fg);
  }

  .dark .mark {
    background: var(--night-2);
    border-color: var(--night-line);
    box-shadow: none;
  }
</style>
