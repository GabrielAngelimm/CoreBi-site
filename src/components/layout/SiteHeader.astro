---
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import Logo from "@/components/ui/Logo.astro";
import { nav, site } from "@/config/site";
---

<header class="header" data-header>
  <div class="wrap">
    <div class="bar">
      <a class="brand" href="#inicio" aria-label="CoreBi, início">
        <Logo />
        CoreBi
      </a>
      <nav class="nav" aria-label="Seções">
        <span class="indicator" data-indicator aria-hidden="true"></span>
        {nav.map((item) => (
          <a href={item.href} data-nav={item.sections.join(" ")}>
            {item.label}
          </a>
        ))}
      </nav>
      <div class="actions">
        <a
          class="github"
          href={site.links.code}
          target="_blank"
          rel="noopener"
          aria-label="Código no GitHub"
        >
          <Icon name="githubSolid" />
        </a>
        <Button href="#baixar" size="sm" icon="download" class="cta">
          Baixar
        </Button>
      </div>
    </div>
  </div>
</header>

<script>
  import "./site-header.client";
</script>

<style>
  .header {
    position: fixed;
    inset: calc(env(safe-area-inset-top, 0px) + var(--nav-top)) 0 auto;
    z-index: 40;
    pointer-events: none;
  }

  .bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 24px;
    max-width: 1180px;
    height: var(--nav-height);
    margin: 0 auto;
    padding: 0 10px 0 22px;
    border: 1px solid color-mix(in srgb, var(--ink) 7%, transparent);
    border-radius: var(--radius-pill);
    background: var(--glass-soft);
    box-shadow:
      0 1px 0 var(--glass) inset,
      var(--shadow-sm);
    backdrop-filter: saturate(1.6) blur(16px);
    -webkit-backdrop-filter: saturate(1.6) blur(16px);
    pointer-events: auto;
    transition:
      background-color 0.35s,
      border-color 0.35s,
      box-shadow 0.35s,
      color 0.35s;
  }

  /* depois da abertura: vidro mais denso, borda e sombra que separam do conteúdo */
  .header:global(.is-stuck) .bar {
    border-color: color-mix(in srgb, var(--ink) 12%, transparent);
    background: var(--glass-strong);
    box-shadow:
      0 1px 0 var(--paper) inset,
      0 2px 6px color-mix(in srgb, var(--ink) 6%, transparent),
      0 18px 40px -18px color-mix(in srgb, var(--ink) 30%, transparent);
    backdrop-filter: saturate(1.8) blur(22px);
    -webkit-backdrop-filter: saturate(1.8) blur(22px);
  }

  /* sobre uma seção escura o vidro escurece junto */
  .header:global(.on-dark) .bar {
    border-color: color-mix(in srgb, var(--night-fg) 12%, transparent);
    background: color-mix(in srgb, var(--night-2) 72%, transparent);
    box-shadow:
      0 1px 0 color-mix(in srgb, var(--night-fg) 8%, transparent) inset,
      0 18px 40px -18px rgb(0 0 0 / 60%);
    color: var(--night-fg);
  }

  .brand {
    display: flex;
    flex: none;
    align-items: center;
    gap: 10px;
    font: 600 22px/1 var(--font-display);
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
    transition: color 0.35s;
  }

  .brand :global(.logo) {
    width: 30px;
    height: 30px;
  }

  .nav {
    position: relative;
    display: flex;
    gap: 2px;
    margin: 0 auto;
  }

  .nav a {
    position: relative;
    z-index: 1;
    padding: 11px 15px;
    border-radius: var(--radius-pill);
    font: 500 15px/1 var(--font-display);
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav a:hover,
  .nav a:global(.active) {
    color: var(--ink);
  }

  /* a pílula que desliza até o item da seção na tela */
  .indicator {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: var(--w, 0);
    border-radius: var(--radius-pill);
    background: var(--paper);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--ink) 8%, transparent),
      0 2px 6px color-mix(in srgb, var(--ink) 8%, transparent);
    opacity: 0;
    transform: translateX(var(--x, 0));
    transition:
      transform 0.5s var(--ease-out),
      width 0.5s var(--ease-out),
      opacity 0.3s;
  }

  .indicator:global(.shown) {
    opacity: 1;
  }

  .actions {
    display: flex;
    flex: none;
    align-items: center;
    gap: 8px;
  }

  .github {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    color: var(--ink);
    transition:
      background-color 0.2s,
      color 0.35s;
  }

  .github:hover {
    background: var(--tint);
  }

  .github :global(.icon) {
    width: 21px;
    height: 21px;
  }

  .header:global(.on-dark) .brand,
  .header:global(.on-dark) .github,
  .header:global(.on-dark) .nav a:hover,
  .header:global(.on-dark) .nav a:global(.active) {
    color: var(--night-fg);
  }

  .header:global(.on-dark) .brand {
    --logo-frame: var(--night-fg);
  }

  .header:global(.on-dark) .actions :global(.cta) {
    background: var(--night-fg);
    color: var(--night);
  }

  .header:global(.on-dark) .nav a {
    color: var(--night-muted);
  }

  .header:global(.on-dark) .indicator {
    background: color-mix(in srgb, var(--night-fg) 12%, transparent);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--night-fg) 10%, transparent);
  }

  .header:global(.on-dark) .github:hover {
    background: color-mix(in srgb, var(--night-fg) 10%, transparent);
  }

  @media (max-width: 1100px) {
    .nav a {
      padding-inline: 11px;
      font-size: 14px;
    }
  }

  @media (max-width: 960px) {
    .nav {
      display: none;
    }

    .actions {
      margin-left: auto;
    }
  }

  @media (max-width: 560px) {
    .bar {
      height: 58px;
      padding-left: 16px;
    }

    .brand {
      font-size: 20px;
    }
  }
</style>
