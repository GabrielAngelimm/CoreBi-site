---
import Button from "@/components/ui/Button.astro";
import Logo from "@/components/ui/Logo.astro";
import { nav } from "@/config/site";
---

<header class="header">
  <div class="wrap">
    <div class="bar">
      <a class="brand" href="#inicio" aria-label="CoreBi, início">
        <Logo />
        CoreBi
      </a>
      <nav class="nav" aria-label="Seções">
        {nav.map((item) => (
          <a href={item.href} {...(item.external ? { target: "_blank", rel: "noopener" } : {})}>
            {item.label}
          </a>
        ))}
      </nav>
      <Button href="#baixar" size="sm" class="cta">
        Baixar
      </Button>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: calc(env(safe-area-inset-top, 0px) + 14px);
    z-index: 40;
    margin-top: 14px;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 20px;
    max-width: 1120px;
    height: var(--nav-height);
    margin: 0 auto;
    padding: 0 10px 0 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 86%);
    box-shadow: var(--shadow-sm);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 600 21px/1 var(--font-display);
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
  }

  .brand :global(.logo) {
    width: 28px;
    height: 28px;
  }

  .nav {
    display: flex;
    gap: 2px;
    margin: 0 auto;
  }

  .nav a {
    padding: 10px 14px;
    border-radius: var(--radius-pill);
    font: 500 15px/1 var(--font-display);
    color: var(--muted);
    text-decoration: none;
    transition:
      color 0.15s,
      background-color 0.15s;
  }

  .nav a:hover {
    background: var(--tint);
    color: var(--ink);
  }

  @media (max-width: 860px) {
    .nav {
      display: none;
    }

    .bar :global(.cta) {
      margin-left: auto;
    }
  }
</style>
