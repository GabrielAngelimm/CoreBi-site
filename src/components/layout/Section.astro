---
/**
 * Uma tela da página. No desktop cada seção tem exatamente a altura da janela, a rolagem
 * para nela (scroll snap) e o conteúdo fica centrado no espaço abaixo do cabeçalho,
 * escalado por --fit para caber inteiro. No celular a seção tem a altura do conteúdo.
 */
interface Props {
  id: string;
  label?: string;
  tone?: "light" | "dark";
  class?: string;
}

const { id, label, tone = "light", class: className } = Astro.props;
---

<section id={id} class:list={["screen", tone, className]} data-tone={tone} aria-labelledby={label}>
  <div class="frame">
    <slot />
  </div>
  <slot name="after" />
</section>

<style>
  .screen {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100vh;
    min-height: 100svh;
    padding-block: var(--header-space) 40px;
    scroll-snap-align: start;
  }

  .frame {
    position: relative;
    z-index: 1;
    zoom: var(--fit);
  }

  .dark {
    background: var(--night);
    color: var(--night-fg);
  }

  .dark :global(.h2) {
    color: var(--night-fg);
  }

  .dark :global(.soft) {
    color: var(--night-soft);
  }

  .dark :global(.lead) {
    color: var(--night-muted);
  }

  @media (max-width: 900px), (max-height: 639px) {
    .screen {
      min-height: 0;
      padding-block: 96px 96px;
    }
  }
</style>
