---
/**
 * A abertura no celular: o ícone do CoreBi grande, no centro de um mostrador com seis medidores
 * em gomos, um por peça do PC, na cor dela, como os medidores segmentados do app. O mostrador
 * acende girando uma vez, os medidores variam por alguns segundos, como leituras ao vivo, e
 * param. O título não espera animação: aparece junto com a página.
 * O mostrador ocupa o espaço que a tela tiver acima do texto, então tudo cabe na primeira tela.
 */
import AppTile from "@/components/ui/AppTile.astro";
import Icon from "@/components/ui/Icon.astro";
import { parts, type Part } from "@/data/parts";
import { formatSize } from "@/lib/format";
import type { Release } from "@/lib/release";
import PhoneActions from "./PhoneActions.astro";

interface Props {
  release: Release;
}

const { release } = Astro.props;
const { installer } = release;

/**
 * Do topo, no sentido horário: as cores vão do verde ao azul, como um espectro. `level` é
 * quantos gomos acendem (de 6); `live` é entre quanto a leitura varia depois.
 */
const meters: readonly { part: Part; level: number; live: readonly [number, number] }[] = [
  { part: "cpu", level: 4, live: [3, 5] },
  { part: "net", level: 3, live: [2, 5] },
  { part: "board", level: 2, live: [2, 3] },
  { part: "gpu", level: 6, live: [5, 6] },
  { part: "memory", level: 5, live: [4, 5] },
  { part: "storage", level: 6, live: [6, 6] },
];

// geometria em unidades do viewBox (-100 a 100): raio do anel, gomos por medidor e folgas
const R = 76;
const SEGMENTS = 6;
const STEP = 360 / meters.length;
const GAP = 12; // entre um medidor e outro, em graus
const SEG_GAP = 2; // entre os gomos
const SPAN = (STEP - GAP - (SEGMENTS - 1) * SEG_GAP) / SEGMENTS;
const ICON_R = 93;

const rad = (deg: number) => (deg * Math.PI) / 180;
const at = (r: number, deg: number) =>
  `${(r * Math.sin(rad(deg))).toFixed(2)} ${(-r * Math.cos(rad(deg))).toFixed(2)}`;

const rings = meters.map((m, i) => {
  const center = i * STEP;
  const first = center - (STEP - GAP) / 2;
  return {
    ...m,
    color: parts[m.part].color,
    icon: parts[m.part].icon,
    // posição do ícone em % do lado do mostrador
    x: (50 + (ICON_R / 2) * Math.sin(rad(center))).toFixed(2),
    y: (50 - (ICON_R / 2) * Math.cos(rad(center))).toFixed(2),
    segments: Array.from({ length: SEGMENTS }, (_, j) => {
      const a = first + j * (SPAN + SEG_GAP);
      return `M${at(R, a)}A${R} ${R} 0 0 1 ${at(R, a + SPAN)}`;
    }),
  };
});
---

<section id="m-abertura" class="m-hero" aria-labelledby="m-hero-title" data-m-hero>
  <div class="dial" aria-hidden="true" data-m-dial>
    <div class="ring">
      <svg viewBox="-100 -100 200 200">
        {rings.map((m) => (
          <g style={`--c:${m.color}`} data-meter data-min={m.live[0]} data-max={m.live[1]}>
            {m.segments.map((d, j) => (
              <path class:list={["seg", { on: j < m.level }]} d={d} />
            ))}
          </g>
        ))}
      </svg>
      {rings.map((m) => (
        <span class="glyph" style={`--c:${m.color};--x:${m.x}%;--y:${m.y}%`}>
          <Icon name={m.icon} />
        </span>
      ))}
    </div>
    <AppTile class="core" />
  </div>

  <div class="wrap text">
    <h1 id="m-hero-title" class="title">
      <span>Monitore, teste</span>
      <span>e cuide do PC.</span>
      <span class="soft">Num app só.</span>
    </h1>
    <p class="lead">
      Sensores, discos, FPS, teste de carga, apps e drivers. Grátis e de código aberto.
    </p>
    <div class="actions">
      <PhoneActions release={release} />
    </div>
    <p class="note">Para Windows 10 e 11 · instalador de {formatSize(installer.sizeBytes)}</p>
  </div>
</section>

<script>
  import "./hero.client";
</script>

<style>
  .m-hero {
    /* o mostrador fica com a altura que sobra depois do texto, entre um mínimo e um máximo */
    --text-block: 468px;
    --size: clamp(136px, 100svh - var(--text-block), min(60vw, 240px));
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100svh;
    padding: var(--m-top) 0 var(--m-bottom);
    overflow: hidden;
  }

  /* ---- mostrador ---- */
  .dial {
    position: relative;
    flex: none;
    width: var(--size);
    aspect-ratio: 1;
    margin: 0 auto 20px;
  }

  /* os pontinhos de radar da versão do computador, só em volta do mostrador */
  .dial::before {
    position: absolute;
    inset: -40%;
    z-index: -1;
    background-image: radial-gradient(circle, var(--dial-tick) 1px, transparent 1.3px);
    background-position: center;
    background-size: 20px 20px;
    mask-image: radial-gradient(closest-side, #000 30%, rgb(0 0 0 / 45%) 60%, transparent);
    content: "";
  }

  .ring {
    position: absolute;
    inset: 0;
  }

  .ring svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .seg {
    fill: none;
    stroke: var(--dial-ring);
    stroke-width: 9;
    transition: stroke 0.35s ease-out;
  }

  .seg.on {
    stroke: var(--c);
  }

  .glyph {
    position: absolute;
    top: var(--y);
    left: var(--x);
    display: grid;
    translate: -50% -50%;
    color: var(--c);
  }

  .glyph :global(.icon) {
    width: calc(var(--size) * 0.072);
    height: calc(var(--size) * 0.072);
  }

  .dial :global(.core) {
    --s: calc(var(--size) * 0.46);
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
  }

  /*
   * Entrada: o anel acende girando uma volta, do topo no sentido horário, e o ícone chega
   * junto. Com movimento reduzido, tudo já está no lugar.
   */
  @property --m-sweep {
    syntax: "<angle>";
    inherits: false;
    initial-value: 360deg;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ring {
      mask-image: conic-gradient(#000 var(--m-sweep), transparent 0);
      animation: m-hero-sweep 1.1s var(--ease-out) 0.1s both;
    }

    .dial :global(.core) {
      animation: m-hero-pop 0.6s var(--ease-out) both;
    }
  }

  @keyframes m-hero-sweep {
    from {
      --m-sweep: 0deg;
    }

    to {
      --m-sweep: 360deg;
    }
  }

  @keyframes m-hero-pop {
    from {
      opacity: 0;
      scale: 0.9;
    }
  }

  /* ---- texto: centrado e grande, como na abertura do computador ---- */
  .text {
    text-align: center;
  }

  .title {
    margin: 0;
    font: 500 var(--display-phone) / 0.97 var(--font-display);
    letter-spacing: -0.04em;
    color: var(--ink);
  }

  /* cada parte é uma linha: sem quebra, a troca da fonte não muda a altura do título */
  .title span {
    display: block;
    white-space: nowrap;
  }

  .lead {
    max-width: 336px;
    margin: 12px auto 0;
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--muted);
    text-wrap: balance;
  }

  .actions {
    margin-top: 20px;
  }

  .actions :global(.actions) {
    justify-content: center;
  }

  .note {
    margin: 12px 0 0;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--faint);
  }

  /* telas baixas: título um passo menor, e o mostrador fica com o resto */
  @media (max-height: 620px) {
    .m-hero {
      --text-block: 412px;
    }

    .title {
      font-size: var(--display-lg);
    }

    .lead {
      font-size: var(--text-base);
    }
  }

  /* telas estreitas e baixas (iPhone SE de 1ª geração): o texto quebra mais, o mostrador cede */
  @media (max-width: 340px) and (max-height: 620px) {
    .m-hero {
      --text-block: 436px;
      --size: clamp(120px, 100svh - var(--text-block), 200px);
    }

    .title {
      font-size: var(--display-md);
    }
  }

  /* celular deitado: mostrador à esquerda e texto à direita, tudo na primeira tela */
  @media (orientation: landscape) {
    .m-hero {
      --size: min(52svh, 220px);
      --left: max(24px, env(safe-area-inset-left, 0px));
      flex-direction: row;
      align-items: center;
      gap: 40px;
      padding: var(--m-top) max(24px, env(safe-area-inset-right, 0px)) 20px var(--left);
    }

    .dial {
      margin: 0;
    }

    .text {
      padding: 0;
      text-align: left;
    }

    .title {
      font-size: var(--display-md);
    }

    .lead {
      margin: 8px 0 0;
      font-size: var(--text-md);
    }

    .actions {
      max-width: 420px;
      margin-top: 16px;
    }

    .actions :global(.actions) {
      justify-content: flex-start;
    }

    .note {
      margin-top: 8px;
    }
  }
</style>
