---
/**
 * Ferramentas, no celular: o teste de carga, os drivers e a instalação de apps, que no
 * computador são três telas, viram uma seção com três abas. Dá para tocar na aba ou passar
 * com o dedo. Cada demonstração toca quando a aba aparece.
 */
import { Image } from "astro:assets";
import Bubble from "@/components/ui/Bubble.astro";
import Icon from "@/components/ui/Icon.astro";
import { queue } from "@/data/apps";
import { driverExample as d } from "@/data/drivers";
import { scenarios, stress } from "@/data/stress";
import { clock, decimal } from "@/lib/format";
import Pager from "./Pager.astro";
import PhoneSection from "./PhoneSection.astro";
import { APP_START_MS, APP_STEP_MS, STRESS_DRAW_MS } from "./tools-timing";

// ---- teste de carga: as curvas saem do mesmo modelo da versão do computador, sem ruído ----
const { min, max, cut, steps, start } = stress;
const W = 320;
const H = 150;
const x = (step: number) => (step / steps) * W;
const y = (t: number) => H - ((t - min) / (max - min)) * H;
const curve = (top: number, k: number, step: number) => top - (top - start) * Math.exp(-k * step);

const runs = scenarios.map((s) => {
  const cpu: number[] = [];
  const gpu: number[] = [];
  for (let step = 0; step <= steps; step++) {
    const c = Math.min(curve(s.cpu, s.k, step), cut);
    cpu.push(c);
    gpu.push(curve(s.gpu, s.k * 0.8, step));
    if (c >= cut) break;
  }
  const path = (values: number[]) =>
    values.map((v, i) => `${i ? "L" : "M"}${x(i).toFixed(1)} ${y(v).toFixed(1)}`).join("");
  const last = cpu.length - 1;
  const stopped = (cpu[last] ?? 0) >= cut;
  return {
    label: s.label,
    cpuLine: path(cpu),
    gpuLine: path(gpu),
    area: `${path(cpu)}L${x(last).toFixed(1)} ${H}L0 ${H}Z`,
    tip: { x: x(last), cpu: y(cpu[last] ?? start), gpu: y(gpu[last] ?? start) },
    cpu: cpu[last] ?? start,
    gpu: gpu[last] ?? start,
    seconds: last * 5,
    stopped,
    // a linha anda sempre na mesma velocidade: o teste que para antes desenha menos
    ms: Math.round((STRESS_DRAW_MS * last) / steps),
    message: stopped
      ? `Parado aos ${clock(last * 5)}: o processador chegou a ${cut} °C. Confira o cooler.`
      : `Aprovado: estável por 10 min, sem erros. Máxima de ${decimal(Math.max(...cpu))} °C.`,
  };
});
const cutY = y(cut);
const grid = [40, 60, 80].map((t) => ({ t, y: y(t) }));

// ---- drivers: cada passo começa quando o anterior termina ----
let elapsed = 0;
const driverSteps = d.steps.map((s) => {
  const at = elapsed;
  elapsed += s.ms;
  return { ...s, at, end: elapsed };
});
const driversDone = elapsed;

const appsDone = APP_START_MS + queue.length * APP_STEP_MS;
---

<PhoneSection id="m-ferramentas" name="Ferramentas" label="m-tools-title">
  <h2 id="m-tools-title" class="h2">
    Teste, atualize e instale. <span class="soft">Sem complicação.</span>
  </h2>
  <p class="lead">Três ferramentas para antes da partida e para depois de formatar.</p>

  <div class="tools">
    <Pager kind="tabs" labels={["Teste de carga", "Drivers", "Apps"]} label="Ferramentas do CoreBi">
      <!-- teste de carga -->
      <article class="slide tool">
        <h3>Seu PC aguenta horas de jogo?</h3>
        <p>
          Deixa o PC no máximo por alguns minutos para achar problemas de calor. Passou do limite? O
          teste para sozinho.
        </p>
        <div
          class="card stress"
          data-play="manual"
          data-m-stress
          data-scenario="0"
          role="group"
          aria-label="Exemplo do teste de carga"
        >
          <div class="pcs" role="group" aria-label="Escolha o PC do exemplo">
            {runs.map((r, i) => (
              <button type="button" data-pick={i} aria-pressed={i === 0 ? "true" : "false"}>
                {r.label}
              </button>
            ))}
          </div>
          <div class="chart">
            <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
              {grid.map((g) => (
                <path class="grid" d={`M0 ${g.y.toFixed(1)}H${W}`} />
              ))}
              <path class="cut" d={`M0 ${cutY.toFixed(1)}H${W}`}></path>
              {runs.map((r, i) => (
                <g data-scene={i} class:list={{ stopped: r.stopped }} style={`--ms:${r.ms}ms`}>
                  <path class="area" d={r.area} />
                  <path class="gpu" d={r.gpuLine} pathLength="1" />
                  <path class="cpu" d={r.cpuLine} pathLength="1" />
                  <circle class="tip gpu-tip" cx={r.tip.x} cy={r.tip.gpu} r="4" />
                  <circle class="tip cpu-tip" cx={r.tip.x} cy={r.tip.cpu} r="4" />
                </g>
              ))}
            </svg>
            <div class="y-labels" aria-hidden="true">
              {grid.map((g) => (
                <span style={`top:${((g.y / H) * 100).toFixed(1)}%`}>{g.t}°</span>
              ))}
            </div>
            <span class="cut-label" style={`top:${((cutY / H) * 100).toFixed(1)}%`}>
              limite {cut} °C
            </span>
            <div class="x-labels" aria-hidden="true">
              <span>0</span>
              <span>5 min</span>
              <span>10 min</span>
            </div>
          </div>
          {runs.map((r, i) => (
            <div class="result" data-scene={i} style={`--ms:${r.ms}ms`}>
              <dl class="reads">
                <div>
                  <dt style="--c:var(--cpu)">
                    <i />
                    Processador
                  </dt>
                  <dd>
                    <span
                      class="num"
                      data-count={r.cpu.toFixed(1)}
                      data-digits="1"
                      data-ms={r.ms}
                      data-ease="linear"
                    >
                      {decimal(r.cpu)}
                    </span>
                    <small>°C</small>
                  </dd>
                </div>
                <div>
                  <dt style="--c:var(--gpu)">
                    <i />
                    Placa de vídeo
                  </dt>
                  <dd>
                    <span
                      class="num"
                      data-count={r.gpu.toFixed(1)}
                      data-digits="1"
                      data-ms={r.ms}
                      data-ease="linear"
                    >
                      {decimal(r.gpu)}
                    </span>
                    <small>°C</small>
                  </dd>
                </div>
                <div>
                  <dt>Tempo</dt>
                  <dd>
                    <span
                      class="num"
                      data-count={r.seconds}
                      data-format="clock"
                      data-ms={r.ms}
                      data-ease="linear"
                    >
                      {clock(r.seconds)}
                    </span>
                  </dd>
                </div>
              </dl>
              <p class:list={["message", r.stopped ? "stop" : "ok"]}>
                <i />
                <span>{r.message}</span>
              </p>
            </div>
          ))}
        </div>
      </article>

      <!-- drivers -->
      <article class="slide tool">
        <h3>Driver novo, sem medo de quebrar.</h3>
        <p>
          Baixa o driver da NVIDIA do site oficial e guarda um backup de todos os drivers antes de
          atualizar.
        </p>
        <div
          class="card drivers"
          data-play
          style={`--done:${driversDone}ms`}
          role="group"
          aria-label="Exemplo de atualização do driver da placa de vídeo"
        >
          <div class="device">
            <Bubble part="gpu" class="device-icon" />
            <div>
              <b>{d.device}</b>
              <span>Placa de vídeo · {d.vendor}</span>
            </div>
          </div>
          <div class="versions">
            <div class="old">
              <span>Instalado</span>
              <b class="num">{d.installed}</b>
            </div>
            <Icon name="arrowRight" class="arrow" />
            <div class="new">
              <span>Mais recente</span>
              <b class="num">{d.latest}</b>
            </div>
          </div>
          <ol class="steps">
            {driverSteps.map((s) => (
              <li style={`--at:${s.at}ms;--end:${s.end}ms`}>
                <span class="mark">
                  <Icon name="check" />
                </span>
                <div>
                  <b>{s.title}</b>
                  {"count" in s ? (
                    <em>
                      <span class="num" data-count={s.count} data-ms={s.ms} data-delay={s.at}>
                        {s.count}
                      </span>{" "}
                      MB
                    </em>
                  ) : (
                    <em>{s.detail}</em>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </div>
      </article>

      <!-- apps -->
      <article class="slide tool">
        <h3>Formatou? Instale tudo de uma vez.</h3>
        <p>Marque os apps e o CoreBi instala um por um, direto da fonte oficial.</p>
        <div
          class="card apps"
          data-play="manual"
          data-m-apps
          style={`--step:${APP_STEP_MS}ms;--start:${APP_START_MS}ms;--done:${appsDone}ms`}
        >
          <ul class="grid-apps" aria-label="Exemplo de instalação em fila">
            {queue.map((app, i) => (
              <li style={`--i:${i}`} data-app={app.name}>
                <span class="icon-wrap">
                  <Image src={app.icon} alt="" width={64} height={64} loading="lazy" />
                </span>
                <span class="badge">
                  <Icon name="check" />
                </span>
                <em>{app.name}</em>
              </li>
            ))}
          </ul>
          <div class="queue">
            <span class="seal" aria-hidden="true">
              <Icon name="check" />
            </span>
            <span class="queue-text">
              <b data-status>Tudo instalado</b>
              <span>
                <span
                  class="num"
                  data-count={queue.length}
                  data-ms={queue.length * APP_STEP_MS}
                  data-delay={APP_START_MS}
                  data-ease="linear"
                >
                  {queue.length}
                </span>{" "}
                de {queue.length} apps
              </span>
            </span>
            <span class="segs" aria-hidden="true">
              {queue.map((_, i) => (
                <i style={`--i:${i}`} />
              ))}
            </span>
          </div>
        </div>
      </article>
    </Pager>
  </div>
</PhoneSection>

<script>
  import "./tools.client";
</script>

<style>
  .tools {
    margin-top: 32px;
  }

  .tool {
    display: flex;
    flex-direction: column;
  }

  .tool h3 {
    margin: 0 0 8px;
    font: 500 var(--text-2xl)/1.15 var(--font-display);
    letter-spacing: -0.01em;
    color: var(--ink);
    text-wrap: balance;
  }

  .tool > p {
    margin: 0 0 20px;
    font-size: var(--text-base);
    line-height: 1.55;
    color: var(--muted);
  }

  .card {
    flex: 1;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper);
    box-shadow: var(--shadow-sm);
  }

  /* ---- teste de carga ---- */
  .stress {
    padding: 16px 16px 20px;
  }

  .pcs {
    display: inline-flex;
    gap: 4px;
    margin-bottom: 16px;
    padding: 4px;
    border-radius: var(--radius-pill);
    background: var(--tint);
  }

  .pcs button {
    height: 34px;
    padding: 0 14px;
    border: 0;
    border-radius: var(--radius-pill);
    background: none;
    color: var(--muted);
    font: 500 var(--text-sm)/1 var(--font-display);
    cursor: pointer;
  }

  .pcs [aria-pressed="true"] {
    background: var(--paper);
    color: var(--ink);
    box-shadow: var(--shadow-sm);
  }

  .chart {
    position: relative;
    margin-left: 28px;
  }

  .chart svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .grid {
    stroke: var(--line);
    stroke-dasharray: 3 4;
  }

  .cut {
    stroke: var(--danger);
    stroke-width: 1.25;
    stroke-dasharray: 5 4;
  }

  .area {
    fill: var(--cpu-soft);
  }

  .cpu,
  .gpu {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cpu {
    stroke: var(--cpu);
    stroke-width: 2.25;
  }

  .gpu {
    stroke: var(--gpu);
    stroke-width: 1.75;
  }

  .tip {
    stroke: var(--paper);
    stroke-width: 2;
  }

  .cpu-tip {
    fill: var(--cpu);
  }

  .gpu-tip {
    fill: var(--gpu);
  }

  /* no cooler fraco o teste para no limite: a curva do processador fica vermelha */
  .stopped .cpu {
    stroke: var(--danger);
  }

  .stopped .area {
    fill: var(--danger-soft);
  }

  .stopped .cpu-tip {
    fill: var(--danger);
  }

  .y-labels span {
    position: absolute;
    left: -28px;
    translate: 0 -50%;
    font: 500 var(--text-2xs)/1 var(--font-readout);
    color: var(--faint);
  }

  .cut-label {
    position: absolute;
    right: 0;
    translate: 0 calc(-100% - 4px);
    font: 500 var(--text-2xs)/1 var(--font-display);
    color: var(--danger-text);
  }

  .x-labels {
    display: flex;
    justify-content: space-between;
    margin-top: 8px;
    font: 500 var(--text-2xs)/1 var(--font-readout);
    color: var(--faint);
  }

  /* só o PC escolhido aparece */
  .stress[data-scenario="0"] [data-scene="1"],
  .stress[data-scenario="1"] [data-scene="0"] {
    display: none;
  }

  .reads {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 12px;
    margin: 20px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .reads dt {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
    font: 500 var(--text-xs)/1 var(--font-display);
    color: var(--faint);
    white-space: nowrap;
  }

  .reads dt i {
    width: 10px;
    height: 3px;
    border-radius: 2px;
    background: var(--c);
  }

  .reads dd {
    display: flex;
    align-items: baseline;
    gap: 3px;
    margin: 0;
  }

  .reads .num {
    font: 600 var(--num-sm)/1 var(--font-readout);
    color: var(--ink);
  }

  .reads small {
    font: 500 var(--text-sm)/1 var(--font-display);
    color: var(--faint);
  }

  .message {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 64px;
    margin: 16px 0 0;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    background: var(--tint);
    font: 500 var(--text-sm)/1.4 var(--font-display);
    color: var(--text);
  }

  .message i {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--success);
  }

  .message.stop {
    background: var(--danger-soft);
    color: var(--danger-text);
  }

  .message.stop i {
    background: var(--danger);
  }

  .armed .cpu,
  .armed .gpu {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .armed .area,
  .armed .tip,
  .armed .message {
    opacity: 0;
  }

  .playing .cpu,
  .playing .gpu {
    stroke-dasharray: 1;
    animation: m-tools-trace var(--ms) linear both;
  }

  .playing .area {
    animation: m-tools-fade 0.5s ease-out var(--ms) both;
  }

  .playing .tip {
    animation: m-tools-fade 0.3s ease-out var(--ms) both;
  }

  .playing .message {
    animation: m-tools-fade 0.4s ease-out var(--ms) both;
  }

  /* ---- drivers ---- */
  .drivers {
    padding: 20px;
  }

  .device {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .device :global(.device-icon) {
    --s: 48px;
  }

  .device b {
    display: block;
    font: 500 var(--text-lg)/1.2 var(--font-display);
    color: var(--ink);
  }

  .device span {
    font-size: var(--text-sm);
    color: var(--faint);
  }

  .versions {
    display: flex;
    align-items: flex-end;
    gap: 12px;
    margin: 20px 0;
    padding: 16px 0;
    border-block: 1px solid var(--line);
  }

  .versions span {
    display: block;
    margin-bottom: 6px;
    font: 500 var(--text-xs)/1 var(--font-display);
    color: var(--faint);
  }

  .versions b {
    position: relative;
    font: 600 var(--num-sm)/1 var(--font-readout);
  }

  .old b {
    color: var(--soft);
  }

  /* o número antigo é riscado quando o novo termina de instalar */
  .old b::after {
    position: absolute;
    top: 52%;
    left: -2px;
    right: -2px;
    height: 2px;
    background: currentColor;
    content: "";
  }

  .new b {
    color: var(--signal-text);
  }

  .versions :global(.arrow) {
    width: 32px;
    height: 16px;
    margin-bottom: 8px;
    color: var(--tick);
  }

  .steps {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .mark {
    display: grid;
    flex: none;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--signal);
    color: var(--on-ink);
  }

  .mark :global(.icon) {
    width: 16px;
    height: 16px;
    stroke-width: 2;
  }

  .steps b {
    display: block;
    font: 500 var(--text-md)/1.25 var(--font-display);
    color: var(--ink);
  }

  .steps em {
    font-size: var(--text-xs);
    font-style: normal;
    color: var(--faint);
  }

  /* cada passo começa como um aro vazio, acende quando começa e fecha com o check quando
     termina; o texto fica sempre legível */
  .armed .mark {
    background: transparent;
    box-shadow: inset 0 0 0 2px var(--line-2);
  }

  .armed .mark :global(.icon),
  .armed .old b::after {
    scale: 0;
  }

  .armed .new b {
    color: var(--soft);
  }

  .playing .mark {
    animation:
      m-tools-ring 0.3s ease-out var(--at) both,
      m-tools-fill 0.3s var(--ease-out) var(--end) both;
  }

  .playing .mark :global(.icon) {
    animation: m-tools-pop 0.35s var(--ease-out) var(--end) both;
  }

  .playing .old b::after {
    transform-origin: left;
    animation: m-tools-strike 0.4s var(--ease-out) var(--done) both;
  }

  .playing .new b {
    animation: m-tools-new 0.4s ease-out var(--done) both;
  }

  /* ---- apps ---- */
  .apps {
    padding: 20px 16px;
  }

  .grid-apps {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid-apps li {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 6px;
  }

  .icon-wrap {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1px solid var(--line);
    border-radius: 15px;
    background: var(--paper);
    box-shadow: var(--shadow-sm);
  }

  .icon-wrap :global(img) {
    width: 32px;
    height: 32px;
  }

  .badge {
    position: absolute;
    top: -4px;
    right: calc(50% - 32px);
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border: 2px solid var(--paper);
    border-radius: 50%;
    background: var(--signal);
    color: var(--on-ink);
  }

  .badge :global(.icon) {
    width: 11px;
    height: 11px;
    stroke-width: 2.5;
  }

  .grid-apps em {
    max-width: 100%;
    overflow: hidden;
    font-size: var(--text-2xs);
    font-style: normal;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--faint);
  }

  .queue {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  /* o selo: um anel que enche com a fila e vira um disco com o visto */
  .seal {
    position: relative;
    display: grid;
    flex: none;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--signal);
    color: var(--on-ink);
  }

  .seal::before {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(var(--signal-hi) calc(var(--p) * 1%), var(--line) 0);
    mask: radial-gradient(closest-side, transparent calc(100% - 3px), #000 calc(100% - 2.5px));
    content: "";
    opacity: 0;
  }

  .seal :global(.icon) {
    width: 20px;
    height: 20px;
    stroke-width: 2;
  }

  .queue-text {
    display: grid;
    gap: 4px;
  }

  .queue-text b {
    font: 500 var(--text-md)/1.2 var(--font-display);
    color: var(--ink);
  }

  .queue-text > span {
    font-size: var(--text-xs);
    color: var(--faint);
  }

  /* um segmento por app, aceso quando ele termina */
  .segs {
    display: flex;
    gap: 3px;
    margin-left: auto;
  }

  .segs i {
    width: 6px;
    height: 18px;
    border-radius: 2px;
    background: var(--signal-hi);
  }

  .armed .segs i {
    background: var(--line);
  }

  .playing .segs i {
    animation: m-tools-seg 0.2s ease-out both;
    animation-delay: calc(var(--start) + (var(--i) + 1) * var(--step) - 60ms);
  }

  .armed .icon-wrap {
    filter: grayscale(1);
    opacity: 0.35;
  }

  .armed .badge,
  .armed .seal :global(.icon) {
    scale: 0;
  }

  .armed .seal {
    background: transparent;
  }

  .playing .icon-wrap {
    animation: m-tools-installed 0.4s ease-out both;
    animation-delay: calc(var(--start) + var(--i) * var(--step));
  }

  .playing .badge {
