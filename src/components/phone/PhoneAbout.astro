---
/**
 * Sobre, no celular: os seis programas que viram um (seis ícones soltos, uma seta e o ícone
 * do CoreBi) e os quatro números, que sobem do zero quando aparecem.
 */
import AppTile from "@/components/ui/AppTile.astro";
import Icon from "@/components/ui/Icon.astro";
import { facts, replacedTools } from "@/data/about";
import { parts } from "@/data/parts";
import PhoneSection from "./PhoneSection.astro";
---

<PhoneSection id="m-sobre" name="Sobre" label="m-sobre-title">
  <h2 id="m-sobre-title" class="h2">
    Um app no lugar de seis. <span class="soft">Sem pilha de programas.</span>
  </h2>
  <p class="lead">
    Para ver sensores, FPS, saúde do disco, benchmark, rede e drivers, normalmente você precisa de
    seis programas. No CoreBi, está tudo num app só.
  </p>
  <div
    class="merge"
    data-play
    role="img"
    aria-label={`${replacedTools.map((t) => t.label).join(", ")}: seis programas num app só`}
  >
    <ul class="tools" aria-hidden="true">
      {replacedTools.map((t, i) => (
        <li style={`--c:${parts[t.part].color};--i:${i}`}>
          <Icon name={t.icon ?? parts[t.part].icon} />
        </li>
      ))}
    </ul>
    <svg class="arrow" viewBox="0 0 48 24" aria-hidden="true">
      <path d="M2 12h42M36 5l8 7-8 7"></path>
    </svg>
    <AppTile size="sm" class="one" />
  </div>

  <p class="more">
    E tudo roda no seu PC, sem servidor, sem conta e sem anúncio. O&nbsp;código é aberto.
  </p>

  <dl class="facts" data-play data-threshold="0.15">
    {facts.map((f, i) => (
      <div>
        <dt class="num" data-count={f.value} data-ms="1200" data-delay={i * 120}>
          {f.value}
        </dt>
        <dd>{f.text}</dd>
      </div>
    ))}
  </dl>
</PhoneSection>

<style>
  .merge {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin: 32px 0 28px;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper);
    box-shadow: var(--shadow-sm);
  }

  .tools {
    display: grid;
    grid-template-columns: repeat(3, 40px);
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tools li {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--paper-soft);
    color: var(--c);
  }

  .tools :global(.icon) {
    width: 20px;
    height: 20px;
  }

  .arrow {
    flex: 1;
    min-width: 32px;
    max-width: 56px;
    height: 24px;
    fill: none;
    stroke: var(--tick);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .merge :global(.one) {
    --s: 76px;
    flex: none;
  }

  /* os seis acendem, a seta se desenha e o CoreBi aparece no fim */
  .armed .tools li,
  .armed :global(.one) {
    opacity: 0;
  }

  .armed .arrow path {
    stroke-dasharray: 60;
    stroke-dashoffset: 60;
  }

  .playing .tools li {
    animation: m-about-in 0.5s var(--ease-out) both;
    animation-delay: calc(var(--i) * 0.07s);
  }

  .playing .arrow path {
    stroke-dasharray: 60;
    animation: m-about-draw 0.6s var(--ease-out) 0.5s both;
  }

  .playing :global(.one) {
    animation: m-about-in 0.6s var(--ease-out) 0.95s both;
  }

  @keyframes m-about-in {
    from {
      opacity: 0;
      scale: 0.7;
    }
  }

  @keyframes m-about-draw {
    from {
      stroke-dashoffset: 60;
    }
  }

  .more {
    margin: 0;
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--muted);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 16px;
    margin: 32px 0 0;
  }

  .facts div {
    padding: 20px 0 4px;
    border-top: 1px solid var(--line);
  }

  dt {
    font: 600 var(--num-lg)/1 var(--font-readout);
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  dd {
    margin: 8px 0 0;
    font-size: var(--text-md);
    line-height: 1.45;
    color: var(--muted);
  }
</style>
