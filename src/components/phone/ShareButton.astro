---
/**
 * Manda o link do site para o computador: abre o compartilhar do sistema (WhatsApp, e-mail,
 * Telegram) com o endereço. Sem o compartilhar, copia o link e avisa no próprio botão.
 */
import Icon from "@/components/ui/Icon.astro";
import { shareText } from "@/data/phone";

const url = Astro.site?.href ?? "/";
---

<button type="button" class="share" data-share data-url={url} data-text={shareText}>
  <Icon name="send" />
  <span data-share-label>Enviar o link para o PC</span>
</button>

<script>
  import "./share.client";
</script>

<style>
  .share {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    height: 52px;
    padding: 0 24px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--on-ink);
    box-shadow: var(--shadow-sm);
    font: 500 var(--text-base)/1 var(--font-display);
    white-space: nowrap;
    cursor: pointer;
    transition: transform 0.15s ease-out;
    -webkit-tap-highlight-color: transparent;
  }

  .share:active {
    transform: scale(0.98);
  }

  .share :global(.icon) {
    width: 18px;
    height: 18px;
  }
</style>
