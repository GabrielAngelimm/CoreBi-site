---
/**
 * O fim da página, no celular: uma segunda abertura, escura. O símbolo do CoreBi grande em
 * traço, o título, os dois botões (baixar e GitHub) e, no pé da tela, a mesma faixa da versão
 * do computador, com as leituras passando. Depois da tela, o rodapé com os links.
 */
import Icon from "@/components/ui/Icon.astro";
import Logo from "@/components/ui/Logo.astro";
import { footerLinks } from "@/config/site";
import { readings } from "@/data/final";
import { parts } from "@/data/parts";
import { decimal } from "@/lib/format";
import type { Release } from "@/lib/release";
import PhoneActions from "./PhoneActions.astro";

interface Props {
  release: Release;
}

const { release } = Astro.props;
const year = new Date().getFullYear();

/** Quantos caracteres o maior valor de uma leitura ao vivo ocupa, para fixar a largura dele. */
const liveChars = (live: NonNullable<(typeof readings)[number]["live"]>) =>
  Math.max(decimal(live.min, live.digits).length, decimal(live.max, live.digits).length);
---

<section
  id="m-baixar"
  class="m-final"
  data-tone="dark"
  data-m-section=""
  aria-labelledby="m-final-title"
>
  <div class="wrap content">
    <svg class="mark" viewBox="0 0 256 256" aria-hidden="true">
      <polygon
        class="frame"
        pathLength="1"
        points="141,35 81,35 34,82 34,174 81,221 141,221 141,195 93,195 60,162 60,94 93,61 141,61"
      ></polygon>
      <polygon
        class="frame"
        pathLength="1"
        points="155,35 184,35 218,69 218,108 202,124 222,144 222,185 186,221 155,221 155,195 175,195 196,174 196,156 178,138 155,138 155,112 177,112 192,97 192,81 173,61 155,61"
      ></polygon>
      <polygon class="core" points="95,84 117,84 117,106 95,106"></polygon>
      <polygon class="core" points="95,121 117,121 117,172 95,172"></polygon>
    </svg>

    <h2 id="m-final-title" class="title">
      Abra uma vez <span class="soft">e veja o seu PC por inteiro.</span>
    </h2>

    <div class="actions">
      <PhoneActions release={release} tone="dark" />
    </div>
  </div>

  <!-- a faixa da versão do computador: leituras ao vivo passando, sem parar -->
  <div class="ticker" aria-hidden="true" data-m-ticker>
    <div class="track">
      {[0, 1].map(() => (
        <ul>
          {readings.map((r, i) => (
            <li style={`--c:${parts[r.part].color}`}>
              <Icon name={parts[r.part].icon} />
              <span class="label">{r.label}</span>
              {r.live ? (
                <span class="value">
                  <b
                    class="num"
                    data-tick={i}
                    data-min={r.live.min}
                    data-max={r.live.max}
                    data-digits={r.live.digits}
                    style={`--chars:${liveChars(r.live)}`}
                  >
                    {decimal((r.live.min + r.live.max) / 2, r.live.digits)}
                  </b>
                  <small>{r.live.unit}</small>
                </span>
              ) : (
                <span class="value">
                  <b class="num">{r.value}</b>
                </span>
              )}
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>

<footer class="foot">
  <div class="wrap">
    <a class="brand" href="#m-abertura">
      <Logo />
      CoreBi
    </a>
    <nav aria-label="Links">
      {footerLinks.map((link) => (
        <a href={link.href} target="_blank" rel="noopener">
          {link.label}
        </a>
      ))}
    </nav>
    <span class="credit">Feito por Gabriel · {year}</span>
  </div>
</footer>

<script>
  import "./final.client";
</script>

<style>
  .m-final {
    /* o símbolo fica com a altura que sobra depois do título, dos botões e da faixa */
    --mark: clamp(120px, 100svh - 432px, min(64vw, 260px));
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding-top: var(--m-top);
    overflow: hidden;
    background: var(--night);
    color: var(--night-fg);
  }

  /* a grade fina da versão do computador, sumindo nas bordas */
  .m-final::after {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(color-mix(in srgb, var(--night-fg) 5%, transparent) 1px, transparent 1px),
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--night-fg) 5%, transparent) 1px,
        transparent 1px
      );
    background-size: 32px 32px;
    mask-image: radial-gradient(ellipse 80% 50% at 50% 30%, #000 20%, transparent 75%);
    content: "";
    pointer-events: none;
  }

  .content {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    padding-block: 8px 32px;
  }

  /* ---- o símbolo em traço, como o gigante da versão do computador ---- */
  .mark {
    width: var(--mark);
    height: var(--mark);
    margin: 0 auto 24px;
    overflow: visible;
  }

  .mark polygon {
    stroke-linejoin: round;
  }

  .frame {
    fill: none;
    stroke: color-mix(in srgb, var(--night-fg) 42%, transparent);
    stroke-width: 1.4;
  }

  .core {
    fill: color-mix(in srgb, var(--signal-hi) 14%, transparent);
    stroke: var(--signal-hi);
    stroke-width: 1.6;
  }

  @media (prefers-reduced-motion: no-preference) {
    .frame {
      stroke-dasharray: 1;
      animation: m-final-draw 1.6s var(--ease-in-out) both;
    }

    .core {
      animation: m-final-core 0.6s var(--ease-out) 1.1s both;
    }
  }

  @keyframes m-final-draw {
    from {
      stroke-dashoffset: 1;
    }

    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes m-final-core {
    from {
      opacity: 0;
    }
  }

  .title {
    margin: 0;
    font: 500 var(--display-lg) / 1 var(--font-display);
    letter-spacing: -0.035em;
    color: var(--night-fg);
    text-wrap: balance;
  }

  .title .soft {
    color: var(--night-soft);
  }

  .actions {
    margin-top: 28px;
  }

  /* ---- faixa ---- */
  .ticker {
    border-top: 1px solid var(--night-line);
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }

  /*
   * As duas cópias da lista andam juntas e a faixa volta ao início quando a primeira saiu
   * inteira (-50%). Cada número ao vivo tem largura fixa e as duas cópias mostram o mesmo
   * valor, então a volta não dá tranco.
   */
  .track {
    display: flex;
    width: max-content;
    animation: m-final-ticker 48s linear infinite;
    will-change: transform;
  }

  .ticker ul {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ticker li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 18px 28px calc(env(safe-area-inset-bottom, 0px) + 18px);
    border-right: 1px solid var(--night-line);
    white-space: nowrap;
  }

  .ticker :global(.icon) {
    width: 18px;
    height: 18px;
    color: var(--c);
  }

  .label {
    font: 500 var(--text-sm)/1 var(--font-display);
    color: var(--night-muted);
  }

  .value {
    display: flex;
    align-items: baseline;
    gap: 4px;
  }

  .value b {
    font: 600 var(--text-lg)/1 var(--font-readout);
    color: var(--night-fg);
  }

  .value b[data-tick] {
    display: inline-block;
    min-width: calc(var(--chars) * 1ch);
    text-align: right;
  }

  .value small {
    font: 500 var(--text-xs)/1 var(--font-display);
    color: var(--night-faint);
  }

  @keyframes m-final-ticker {
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }
  }

  @media (max-height: 620px) {
    .m-final {
      --mark: clamp(96px, 100svh - 404px, 200px);
    }

    .title {
      font-size: var(--display-md);
    }
  }

  @media (orientation: landscape) {
    .m-final {
      --mark: 120px;
      min-height: 0;
    }
  }

  /* ---- rodapé ---- */
  .foot {
    padding: 28px 0 calc(env(safe-area-inset-bottom, 0px) + 28px);
    border-top: 1px solid var(--night-line);
    background: var(--night);
    color: var(--night-fg);
  }

  .brand {
    --logo-frame: var(--night-fg);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: 500 var(--text-xl)/1 var(--font-display);
    color: var(--night-fg);
    text-decoration: none;
  }

  .brand :global(.logo) {
    width: 28px;
    height: 28px;
  }

  nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 16px;
    margin: 16px 0 20px;
  }

  nav a {
    padding: 10px 0;
    font-size: var(--text-md);
    color: var(--night-muted);
    text-decoration: none;
  }

  .credit {
    font-size: var(--text-sm);
    color: var(--night-faint);
  }
</style>
