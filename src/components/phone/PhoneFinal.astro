---
/**
 * O fim da página, no celular (escuro): o símbolo do CoreBi inteiro em traço, o título, os dois
 * botões e um quadro de leituras como o app mostra, que varia alguns segundos quando aparece.
 * Embaixo, o rodapé com os links.
 */
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import Logo from "@/components/ui/Logo.astro";
import { footerLinks } from "@/config/site";
import { readings } from "@/data/final";
import { parts } from "@/data/parts";
import { decimal, formatSize } from "@/lib/format";
import type { Release } from "@/lib/release";
import ShareButton from "./ShareButton.astro";

interface Props {
  release: Release;
}

const { installer } = Astro.props.release;
// as leituras que mudam sozinhas no app; a placa-mãe e o teste de carga ficam para a faixa do computador
const panel = readings.filter((r) => r.live || r.part === "storage");
const year = new Date().getFullYear();
---

<section
  id="m-baixar"
  class="m-final"
  data-tone="dark"
  data-m-section=""
  aria-labelledby="m-final-title"
>
  <div class="wrap">
    <svg class="mark" viewBox="0 0 256 256" aria-hidden="true">
      <polygon
        class="frame"
        points="141,35 81,35 34,82 34,174 81,221 141,221 141,195 93,195 60,162 60,94 93,61 141,61"
      ></polygon>
      <polygon
        class="frame"
        points="155,35 184,35 218,69 218,108 202,124 222,144 222,185 186,221 155,221 155,195 175,195 196,174 196,156 178,138 155,138 155,112 177,112 192,97 192,81 173,61 155,61"
      ></polygon>
      <polygon class="core" points="95,84 117,84 117,106 95,106"></polygon>
      <polygon class="core" points="95,121 117,121 117,172 95,172"></polygon>
    </svg>

    <h2 id="m-final-title" class="title">
      Abra uma vez <span class="soft">e veja o seu PC por inteiro.</span>
    </h2>

    <div class="actions">
      <ShareButton variant="light" />
      <Button
        href={installer.url}
        variant="ghost"
        icon="download"
        aria-label={`Baixar para Windows, ${formatSize(installer.sizeBytes)}`}
      >
        Baixar
      </Button>
    </div>

    <ul class="panel" data-play aria-label="Exemplo de leituras do CoreBi">
      {panel.map((r, i) => (
        <li style={`--c:${parts[r.part].color};--i:${i}`}>
          <Icon name={parts[r.part].icon} />
          <span class="label">{r.label}</span>
          {r.live ? (
            <span class="value">
              <b
                class="num"
                data-live
                data-min={r.live.min}
                data-max={r.live.max}
                data-digits={r.live.digits}
              >
                {decimal((r.live.min + r.live.max) / 2, r.live.digits)}
              </b>
              <small>{r.live.unit}</small>
            </span>
          ) : (
            <span class="value">
              <b class="num">{r.value}</b>
            </span>
          )}
        </li>
      ))}
    </ul>
  </div>

  <footer class="foot">
    <div class="wrap">
      <a class="brand" href="#m-abertura">
        <Logo />
        CoreBi
      </a>
      <nav aria-label="Links">
        {footerLinks.map((link) => (
          <a href={link.href} target="_blank" rel="noopener">
            {link.label}
          </a>
        ))}
      </nav>
      <span class="credit">Feito por Gabriel · {year}</span>
    </div>
  </footer>
</section>

<style>
  .m-final {
    padding-top: 72px;
    background: var(--night);
    color: var(--night-fg);
    scroll-margin-top: 0;
  }

  .mark {
    width: 64px;
    height: 64px;
    margin-bottom: 28px;
  }

  .mark .frame {
    fill: none;
    stroke: var(--night-fg);
    stroke-width: 5;
    stroke-linejoin: round;
  }

  .mark .core {
    fill: var(--signal-hi);
  }

  .title {
    margin: 0;
    font: 500 var(--display-lg) / 1 var(--font-display);
    letter-spacing: -0.035em;
    color: var(--night-fg);
    text-wrap: balance;
  }

  .title .soft {
    color: var(--night-soft);
  }

  .actions {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 10px;
    margin-top: 32px;
  }

  .actions > :global(*) {
    width: 100%;
    padding-inline: 16px;
  }

  /* telas bem estreitas: um botão embaixo do outro */
  @media (max-width: 359px) {
    .actions {
      grid-template-columns: 1fr;
    }
  }

  /* ---- quadro de leituras ---- */
  .panel {
    display: grid;
    margin: 40px 0 0;
    padding: 4px 16px;
    list-style: none;
    border: 1px solid var(--night-line);
    border-radius: var(--radius-lg);
    background: var(--night-2);
  }

  .panel li {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    border-top: 1px solid var(--night-line);
  }

  .panel li:first-child {
    border-top: 0;
  }

  .panel :global(.icon) {
    width: 20px;
    height: 20px;
    color: var(--c);
  }

  .label {
    font: 500 var(--text-md)/1 var(--font-display);
    color: var(--night-muted);
  }

  .value {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin-left: auto;
  }

  .value b {
    font: 600 var(--text-2xl)/1 var(--font-readout);
    color: var(--night-fg);
  }

  .value small {
    font: 500 var(--text-sm)/1 var(--font-display);
    color: var(--night-faint);
  }

  .armed li {
    opacity: 0;
  }

  .playing li {
    animation: m-final-on 0.45s var(--ease-out) both;
    animation-delay: calc(var(--i) * 0.07s);
  }

  @keyframes m-final-on {
    from {
      opacity: 0;
      translate: 0 6px;
    }
  }

  /* ---- rodapé ---- */
  .foot {
    margin-top: 56px;
    padding: 32px 0 calc(env(safe-area-inset-bottom, 0px) + 32px);
    border-top: 1px solid var(--night-line);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: 500 var(--text-xl)/1 var(--font-display);
    color: var(--night-fg);
    text-decoration: none;
    --logo-frame: var(--night-fg);
  }

  .brand :global(.logo) {
    width: 28px;
    height: 28px;
  }

  nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px 16px;
    margin: 20px 0 24px;
  }

  nav a {
    padding: 10px 0;
    font-size: var(--text-md);
    color: var(--night-muted);
    text-decoration: none;
  }

  .credit {
    font-size: var(--text-sm);
    color: var(--night-faint);
  }
</style>
