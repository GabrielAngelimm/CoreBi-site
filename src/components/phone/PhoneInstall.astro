---
/**
 * Instalar, no celular: três passos curtos, porque quem lê está no celular e vai instalar
 * depois, no PC. O código de conferência (SHA256) fica guardado em "Conferir o arquivo",
 * para quem quiser comparar; as perguntas frequentes apontam para ele.
 */
import CopyButton from "@/components/ui/CopyButton.astro";
import Icon from "@/components/ui/Icon.astro";
import { phoneInstallSteps } from "@/data/phone";
import { emphasis, formatSize } from "@/lib/format";
import type { Release } from "@/lib/release";
import PhoneSection from "./PhoneSection.astro";

interface Props {
  release: Release;
}

const { installer } = Astro.props.release;
const command = `Get-FileHash .\\${installer.name}`;
const hash = installer.sha256;
const size = formatSize(installer.sizeBytes);
---

<PhoneSection id="m-instalar" name="Instalar" label="m-install-title">
  <h2 id="m-install-title" class="h2">
    Pronto em um minuto. <span class="soft">Em três passos.</span>
  </h2>
  <p class="lead">Abra este site no computador e siga do download ao app aberto.</p>

  <ol class="steps">
    {phoneInstallSteps.map((s, i) => (
      <li>
        <span class="n num" aria-hidden="true">
          {i + 1}
        </span>
        <div>
          <h3>{s.title}</h3>
          <p set:html={emphasis(s.text.replace("{size}", size))} />
        </div>
      </li>
    ))}
  </ol>

  {hash && (
    <details class="verify">
      <summary>
        Conferir o arquivo
        <span class="sha">SHA256</span>
        <Icon name="chevronDown" class="chev" />
      </summary>
      <div class="shell">
        <span class="label">No PowerShell, na pasta do download:</span>
        <code class="cmd">
          <span class="ps">PS&gt;</span> {command}
        </code>
        <span class="label">Tem que dar este código:</span>
        <code class="hash" title={hash}>
          {[hash.slice(0, 32), hash.slice(32)].map((half) => (
            <span>{half.toUpperCase()}</span>
          ))}
        </code>
        <div class="copy">
          <CopyButton
            text={`${command} -Algorithm SHA256`}
            label="Copiar comando do PowerShell"
            tone="dark"
          >
            Copiar comando
          </CopyButton>
          <CopyButton text={hash} label="Copiar código SHA256 esperado" tone="dark">
            Copiar código
          </CopyButton>
        </div>
      </div>
    </details>
  )}
</PhoneSection>

<style>
  .steps {
    display: grid;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 12px;
    padding: 14px 0;
    border-top: 1px solid var(--line);
  }

  .n {
    font: 600 var(--num-sm)/0.8 var(--font-readout);
    color: var(--signal-text);
  }

  h3 {
    margin: 0 0 4px;
    font: 500 var(--text-xl)/1.2 var(--font-display);
    color: var(--ink);
  }

  .steps p {
    margin: 0;
    font-size: var(--text-base);
    line-height: 1.5;
    color: var(--muted);
    text-wrap: balance;
  }

  .steps p :global(b) {
    font-weight: 500;
    color: var(--ink);
  }

  /* ---- conferir o arquivo ---- */
  .verify {
    border-block: 1px solid var(--line);
    interpolate-size: allow-keywords;
  }

  summary {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 52px;
    font: 500 var(--text-base)/1 var(--font-display);
    color: var(--ink);
    list-style: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .sha {
    font: 500 var(--text-xs)/1 var(--font-mono);
    color: var(--faint);
  }

  summary :global(.chev) {
    width: 18px;
    height: 18px;
    margin-left: auto;
    color: var(--muted);
    transition: rotate 0.3s var(--ease-out);
  }

  .verify[open] summary :global(.chev) {
    rotate: 180deg;
  }

  .verify::details-content {
    height: 0;
    overflow: clip;
    transition:
      height 0.32s var(--ease-in-out),
      content-visibility 0.32s allow-discrete;
  }

  .verify[open]::details-content {
    height: auto;
  }

  .shell {
    display: grid;
    gap: 8px;
    margin-bottom: 16px;
    padding: 16px;
    border-radius: var(--radius-md);
    background: var(--night);
    color: var(--night-fg);
    font: 400 var(--text-xs)/1.5 var(--font-mono);
  }

  .shell code {
    font: inherit;
    overflow-wrap: anywhere;
  }

  .ps {
    color: var(--night-faint);
  }

  .label {
    font: 500 var(--text-xs)/1.3 var(--font-display);
    color: var(--night-muted);
  }

  .hash {
    display: grid;
    color: var(--signal-hi);
    letter-spacing: 0.02em;
  }

  .copy {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }

  .copy :global(.copy) {
    height: 36px;
    padding-inline: 14px;
  }

  /* telas baixas: passos mais juntos e texto um passo menor */
  @media (max-height: 620px), (max-width: 370px) and (max-height: 720px) {
    .steps {
      margin-top: 20px;
    }

    .steps li {
      padding: 12px 0;
    }

    h3 {
      font-size: var(--text-lg);
    }

    .steps p {
      font-size: var(--text-md);
    }
  }

  @media (max-height: 620px) {
    .steps {
      margin-top: 16px;
    }

    .steps li {
      padding: 8px 0;
    }

    summary {
      min-height: 40px;
    }
  }
</style>
