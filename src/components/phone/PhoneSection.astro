---
/**
 * Uma seção da versão para celular: título em duas cores, texto curto e a demonstração.
 * Cada seção ocupa uma tela, como no computador: o conteúdo fica no meio do espaço entre o
 * cabeçalho fixo e a borda de baixo, e é desenhado para caber na menor tela comum de celular
 * em pé (100svh, com as barras do navegador aparecendo). Deitado, a altura é a do conteúdo.
 * `name` é o que o cabeçalho mostra enquanto a seção está na tela.
 */
interface Props {
  id: string;
  name: string;
  label: string;
  tone?: "light" | "dark";
  class?: string;
}

const { id, name, label, tone = "light", class: className } = Astro.props;
---

<section
  id={id}
  class:list={["m-sec", tone, className]}
  data-tone={tone}
  data-m-section={name}
  aria-labelledby={label}
>
  <div class="wrap">
    <slot />
  </div>
</section>

<style>
  .m-sec {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100svh;
    padding: var(--m-top) 0 var(--m-bottom);
  }

  .m-sec :global(.h2) {
    line-height: 1.04;
  }

  .m-sec :global(.lead) {
    margin-top: 12px;
    font-size: var(--text-lg);
    line-height: 1.5;
  }

  .dark {
    background: var(--night);
    color: var(--night-fg);
  }

  .dark :global(.h2) {
    color: var(--night-fg);
  }

  .dark :global(.soft) {
    color: var(--night-soft);
  }

  .dark :global(.lead) {
    color: var(--night-muted);
  }

  /* telas baixas (iPhone SE) e estreitas e baixas (Android pequeno): títulos e texto um passo menores */
  @media (max-height: 620px), (max-width: 370px) and (max-height: 720px) {
    .m-sec :global(.h2) {
      font-size: var(--text-3xl);
    }

    .m-sec :global(.lead) {
      font-size: var(--text-base);
    }
  }

  /* celular deitado: a seção tem a altura do conteúdo, numa coluna da largura de um celular em pé */
  @media (orientation: landscape) {
    .m-sec {
      min-height: 0;
    }

    .wrap {
      max-width: 600px;
    }
  }
</style>
