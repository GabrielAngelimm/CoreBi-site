---
/**
 * O aviso que sobe quando a pessoa toca em "Baixar para Windows" no celular: o CoreBi é um app
 * de PC e não instala no celular. O desenho mostra o link indo do celular para o computador,
 * e o botão principal faz isso (compartilhar do sistema, ou copia o link). Quem quiser o
 * arquivo mesmo assim, para passar por cabo ou nuvem, tem o link do instalador embaixo.
 */
import { formatSize } from "@/lib/format";
import type { Release } from "@/lib/release";
import PhoneSheet from "./PhoneSheet.astro";
import ShareButton from "./ShareButton.astro";

interface Props {
  release: Release;
}

const { installer } = Astro.props.release;

// o símbolo do CoreBi, o mesmo de Logo.astro, para desenhar dentro das telas
const frames = [
  "141,35 81,35 34,82 34,174 81,221 141,221 141,195 93,195 60,162 60,94 93,61 141,61",
  "155,35 184,35 218,69 218,108 202,124 222,144 222,185 186,221 155,221 155,195 175,195 196,174 196,156 178,138 155,138 155,112 177,112 192,97 192,81 173,61 155,61",
];
const cores = ["95,84 117,84 117,106 95,106", "95,121 117,121 117,172 95,172"];
---

<PhoneSheet id="m-windows" title="O CoreBi é para o PC">
  <div class="body">
    <svg class="art" viewBox="0 0 320 128" aria-hidden="true">
      <!-- o celular, com este site aberto -->
      <rect class="device" x="44" y="14" width="56" height="100" rx="12"></rect>
      <rect class="screen" x="50" y="22" width="44" height="84" rx="7"></rect>
      <g transform="translate(63 55) scale(0.0703)">
        {frames.map((p) => (
          <polygon class="frame" points={p} />
        ))}
        {cores.map((p) => (
          <polygon class="core" points={p} />
        ))}
      </g>

      <!-- o link indo para o PC -->
      <g class="arrow">
        <path class="trail" d="M110 58Q147 18 184 54"></path>
        <path class="head" d="M181.8 45.3L184 54L175.3 51.7"></path>
      </g>

      <!-- o computador, onde o app abre -->
      <rect class="device" x="196" y="14" width="112" height="76" rx="8"></rect>
      <rect class="screen" x="202" y="20" width="100" height="64" rx="4"></rect>
      <path class="stand" d="M252 90v12M236 106h32"></path>
      <g class="app">
        <rect class="tile" x="236" y="36" width="32" height="32" rx="9"></rect>
        <g transform="translate(241 41) scale(0.0859)">
          {frames.map((p) => (
            <polygon class="frame" points={p} />
          ))}
          {cores.map((p) => (
            <polygon class="core" points={p} />
          ))}
        </g>
      </g>
    </svg>

    <p class="text">
      Ele roda no Windows 10 e 11 e não instala no celular. Mande o link para o seu computador e
      baixe por lá.
    </p>

    <ShareButton />
    <a class="anyway" href={installer.url}>
      Baixar o instalador mesmo assim · {formatSize(installer.sizeBytes)}
    </a>
  </div>
</PhoneSheet>

<script>
  import "./windows.client";
</script>

<style>
  .body {
    display: grid;
    gap: 16px;
    padding: 4px 8px 0;
  }

  .art {
    width: 100%;
    height: auto;
    padding: 16px 8px 12px;
    border-radius: var(--radius-md);
    background: var(--bg);
    overflow: visible;
  }

  .device {
    fill: var(--paper);
    stroke: var(--dial-major);
    stroke-width: 1.5;
  }

  .screen {
    fill: var(--tint);
  }

  .stand {
    fill: none;
    stroke: var(--dial-major);
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .frame {
    fill: var(--ink);
  }

  .core {
    fill: var(--signal-hi);
  }

  .tile {
    fill: var(--paper);
    stroke: var(--line-2);
  }

  .arrow {
    fill: none;
    stroke: var(--signal);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .trail {
    stroke-dasharray: 0.1 6;
  }

  .text {
    margin: 0;
    font-size: var(--text-base);
    line-height: 1.55;
    color: var(--muted);
  }

  .anyway {
    justify-self: center;
    padding: 8px 4px;
    font: 500 var(--text-md)/1.2 var(--font-display);
    color: var(--faint);
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-underline-offset: 4px;
  }

  /* ao abrir, o link sai do celular e o app aparece na tela do PC */
  :global(.sheet[open]) .arrow {
    animation: m-notice-send 0.7s var(--ease-out) 0.25s both;
  }

  :global(.sheet[open]) .app {
    transform-box: fill-box;
    transform-origin: center;
    animation: m-notice-arrive 0.5s var(--ease-out) 0.85s both;
  }

  @keyframes m-notice-send {
    from {
      clip-path: inset(0 100% 0 0);
    }

    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes m-notice-arrive {
    from {
      opacity: 0;
      scale: 0.6;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.sheet[open]) .arrow,
    :global(.sheet[open]) .app {
      animation: none;
    }
  }
</style>
