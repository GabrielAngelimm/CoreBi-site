---
/**
 * Drivers e apps, no celular: o que se faz depois de formatar, numa seção só e sem abas. Dois
 * cartões que tocam sozinhos quando aparecem: o driver da placa de vídeo atualizando, com uma
 * barra de quatro passos e uma linha que diz o passo da vez, e a fila de apps instalando.
 */
import { Image } from "astro:assets";
import Bubble from "@/components/ui/Bubble.astro";
import Icon from "@/components/ui/Icon.astro";
import { queue } from "@/data/apps";
import { driverExample as d } from "@/data/drivers";
import PhoneSection from "./PhoneSection.astro";
import { APP_START_MS, APP_STEP_MS } from "./tools-timing";

// cada passo do driver começa quando o anterior termina
let elapsed = 0;
const steps = d.steps.map((s) => {
  const at = elapsed;
  elapsed += s.ms;
  return { ...s, at, end: elapsed };
});
const driversDone = elapsed;
const appsDone = APP_START_MS + queue.length * APP_STEP_MS;
const finalStep = steps.at(-1);
---

<PhoneSection id="m-drivers" name="Drivers e apps" label="m-upkeep-title">
  <h2 id="m-upkeep-title" class="h2">
    Formatou o PC? <span class="soft">Volta tudo em minutos.</span>
  </h2>
  <p class="lead">O driver de vídeo com backup, e os seus apps direto da fonte oficial.</p>

  <div class="cards">
    <div
      class="card drivers"
      data-play
      style={`--done:${driversDone}ms`}
      role="img"
      aria-label={`Exemplo: driver da ${d.device} atualizado de ${d.installed} para ${d.latest}, com backup e sem reiniciar`}
    >
      <div class="device" aria-hidden="true">
        <Bubble part="gpu" class="device-icon" />
        <div class="who">
          <b>{d.device}</b>
          <span class="versions">
            <span class="old num">{d.installed}</span>
            <Icon name="arrowRight" class="arrow" />
            <span class="new num">{d.latest}</span>
          </span>
        </div>
        <span class="mark">
          <Icon name="check" />
        </span>
      </div>
      <div class="bar" aria-hidden="true">
        {steps.map((s) => (
          <i style={`--at:${s.at}ms;--end:${s.end}ms`} />
        ))}
      </div>
      <p class="status" aria-hidden="true">
        {steps.map((s) => (
          <span
            class:list={{ last: s === finalStep }}
            style={`--at:${s.at}ms;--len:${s.end - s.at}ms`}
          >
            <b>{s.title}</b> · {s.detail}
          </span>
        ))}
      </p>
    </div>

    <div
      class="card apps"
      data-play="manual"
      data-m-apps
      style={`--step:${APP_STEP_MS}ms;--start:${APP_START_MS}ms;--done:${appsDone}ms`}
    >
      <ul class="grid-apps" aria-label="Exemplo de apps instalados em fila">
        {queue.map((app, i) => (
          <li style={`--i:${i}`} data-app={app.name}>
            <span class="icon-wrap">
              <Image src={app.icon} alt={app.name} width={64} height={64} loading="lazy" />
            </span>
            <span class="badge" aria-hidden="true">
              <Icon name="check" />
            </span>
          </li>
        ))}
      </ul>
      <div class="queue">
        <span class="seal" aria-hidden="true">
          <Icon name="check" />
        </span>
        <span class="queue-text">
          <b data-status>Tudo instalado</b>
          <span>
            <span
              class="num"
              data-count={queue.length}
              data-ms={queue.length * APP_STEP_MS}
              data-delay={APP_START_MS}
              data-ease="linear"
            >
              {queue.length}
            </span>{" "}
            de {queue.length} apps
          </span>
        </span>
        <span class="segs" aria-hidden="true">
          {queue.map((_, i) => (
            <i style={`--i:${i}`} />
          ))}
        </span>
      </div>
    </div>
  </div>
</PhoneSection>

<script>
  import "./upkeep.client";
</script>

<style>
  .cards {
    display: grid;
    gap: 12px;
    margin-top: 24px;
  }

  .card {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper);
    box-shadow: var(--shadow-sm);
  }

  /* ---- driver ---- */
  .drivers {
    padding: 16px;
  }

  .device {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .device :global(.device-icon) {
    --s: 44px;
  }

  .who {
    display: grid;
    flex: 1;
    gap: 6px;
    min-width: 0;
  }

  .who b {
    font: 500 var(--text-base)/1.2 var(--font-display);
    color: var(--ink);
  }

  .versions {
    display: flex;
    align-items: center;
    gap: 8px;
    font: 600 var(--text-lg)/1 var(--font-readout);
  }

  .old {
    position: relative;
    color: var(--faint);
  }

  /* o número antigo é riscado quando o novo termina de instalar */
  .old::after {
    position: absolute;
    top: 52%;
    left: -2px;
    right: -2px;
    height: 1.5px;
    background: currentColor;
    content: "";
  }

  .new {
    color: var(--signal-text);
  }

  .versions :global(.arrow) {
    width: 22px;
    height: 12px;
    color: var(--tick);
  }

  .mark {
    display: grid;
    flex: none;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--signal);
    color: var(--on-ink);
  }

  .mark :global(.icon) {
    width: 18px;
    height: 18px;
    stroke-width: 2;
  }

  /* quatro gomos, um por passo, que enchem quando o passo termina */
  .bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
    margin-top: 16px;
  }

  .bar i {
    height: 6px;
    border-radius: 3px;
    background: var(--signal-hi);
  }

  /* o passo da vez; sem animação, fica o último */
  .status {
    display: grid;
    margin: 12px 0 0;
    font-size: var(--text-sm);
    line-height: 1.3;
    color: var(--faint);
  }

  .status > span {
    grid-area: 1 / 1;
    opacity: 0;
  }

  .status > .last {
    opacity: 1;
  }

  .status b {
    font-weight: 500;
    color: var(--ink);
  }

  .armed .mark {
    background: transparent;
    box-shadow: inset 0 0 0 2px var(--line-2);
  }

  .armed .mark :global(.icon),
  .armed .old::after {
    scale: 0;
  }

  .armed .new {
    color: var(--faint);
  }

  .armed .bar i {
    background: var(--line);
  }

  .armed .status > .last {
    opacity: 0;
  }

  .playing .bar i {
    animation: m-up-seg 0.25s ease-out var(--end) both;
  }

  .playing .status > span {
    animation: m-up-step var(--len) linear var(--at) both;
  }

  .playing .status > .last {
    animation: m-up-show 0.25s ease-out var(--at) both;
  }

  .playing .mark {
    animation: m-up-fill 0.3s var(--ease-out) var(--done) both;
  }

  .playing .mark :global(.icon) {
    animation: m-up-pop 0.35s var(--ease-out) var(--done) both;
  }

  .playing .old::after {
    transform-origin: left;
    animation: m-up-strike 0.4s var(--ease-out) var(--done) both;
  }

  .playing .new {
    animation: m-up-new 0.4s ease-out var(--done) both;
  }

  /* ---- apps ---- */
  .apps {
    padding: 16px;
  }

  .grid-apps {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid-apps li {
    position: relative;
    display: grid;
    justify-items: center;
  }

  .icon-wrap {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--paper);
    box-shadow: var(--shadow-sm);
  }

  .icon-wrap :global(img) {
    width: 30px;
    height: 30px;
  }

  .badge {
    position: absolute;
    top: -4px;
    right: calc(50% - 30px);
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border: 2px solid var(--paper);
    border-radius: 50%;
    background: var(--signal);
    color: var(--on-ink);
  }

  .badge :global(.icon) {
    width: 11px;
    height: 11px;
    stroke-width: 2.5;
  }

  .queue {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  /* o selo: um anel que enche com a fila e vira um disco com o visto */
  .seal {
    position: relative;
    display: grid;
    flex: none;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--signal);
    color: var(--on-ink);
  }

  .seal::before {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(var(--signal-hi) calc(var(--p) * 1%), var(--line) 0);
    mask: radial-gradient(closest-side, transparent calc(100% - 3px), #000 calc(100% - 2.5px));
    content: "";
    opacity: 0;
  }

  .seal :global(.icon) {
    width: 18px;
    height: 18px;
    stroke-width: 2;
  }

  .queue-text {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .queue-text b {
    overflow: hidden;
    font: 500 var(--text-md)/1.2 var(--font-display);
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--ink);
  }

  .queue-text > span {
    font-size: var(--text-xs);
    color: var(--faint);
  }

  /* um segmento por app, aceso quando ele termina */
  .segs {
    display: flex;
    flex: none;
    gap: 3px;
    margin-left: auto;
  }

  .segs i {
    width: 5px;
    height: 18px;
    border-radius: 2px;
    background: var(--signal-hi);
  }

  .armed .segs i {
    background: var(--line);
  }

  .playing .segs i {
    animation: m-up-seg 0.2s ease-out both;
    animation-delay: calc(var(--start) + (var(--i) + 1) * var(--step) - 60ms);
  }

  .armed .icon-wrap {
    filter: grayscale(1);
    opacity: 0.35;
  }

  .armed .badge,
  .armed .seal :global(.icon) {
    scale: 0;
  }

  .armed .seal {
    background: transparent;
  }

  .playing .icon-wrap {
    animation: m-up-installed 0.4s ease-out both;
    animation-delay: calc(var(--start) + var(--i) * var(--step));
  }

  .playing .badge {
    animation: m-up-pop 0.35s var(--ease-out) both;
    animation-delay: calc(var(--start) + (var(--i) + 1) * var(--step) - 80ms);
  }

  .playing .seal {
    animation: m-up-fill 0.3s ease-out var(--done) both;
  }

  .playing .seal::before {
    animation: m-up-seal var(--done) linear both;
  }

  .playing .seal :global(.icon) {
    animation: m-up-pop 0.35s var(--ease-out) var(--done) both;
  }

  @keyframes m-up-pop {
    from {
      scale: 0;
    }
  }

  @keyframes m-up-fill {
    from {
      background: transparent;
    }
  }

  @keyframes m-up-new {
    from {
      color: var(--faint);
    }
  }

  @keyframes m-up-strike {
    from {
      scale: 0 1;
    }
  }

  @keyframes m-up-seg {
    from {
      background: var(--line);
    }
  }

  @keyframes m-up-step {
    0%,
    100% {
      opacity: 0;
    }

    8%,
    92% {
      opacity: 1;
    }
  }

  @keyframes m-up-show {
    from {
      opacity: 0;
    }
  }

  @keyframes m-up-installed {
    from {
      filter: grayscale(1);
      opacity: 0.35;
    }
  }

  @keyframes m-up-seal {
    0% {
      --p: 0;
      opacity: 1;
    }

    99% {
      --p: 100;
      opacity: 1;
    }

    100% {
      --p: 100;
      opacity: 0;
    }
  }

  /* telas baixas: ícones e folgas um passo menores */
  @media (max-height: 620px) {
    .cards {
      gap: 10px;
      margin-top: 20px;
    }

    .drivers,
    .apps {
      padding: 14px;
    }

    .grid-apps {
      gap: 8px 4px;
    }

    .icon-wrap {
      width: 36px;
      height: 36px;
      border-radius: 10px;
    }

    .icon-wrap :global(img) {
      width: 24px;
      height: 24px;
    }

    .queue {
      margin-top: 12px;
      padding-top: 12px;
    }
  }
</style>
