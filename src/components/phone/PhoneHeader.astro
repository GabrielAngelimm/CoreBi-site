---
/**
 * Cabeçalho do celular: o logo e um botão que mostra em que seção a pessoa está. Tocar nele
 * abre a folha de baixo com as seções e os botões de baixar, como num app.
 */
import Icon from "@/components/ui/Icon.astro";
import Logo from "@/components/ui/Logo.astro";
import { phoneSections } from "@/data/phone";
import type { Release } from "@/lib/release";
import PhoneActions from "./PhoneActions.astro";
import PhoneSheet from "./PhoneSheet.astro";

interface Props {
  release: Release;
}
---

<header class="m-header" data-m-header>
  <div class="bar">
    <a class="brand" href="#m-abertura" aria-label="CoreBi, início">
      <Logo />
      CoreBi
    </a>
    <button
      type="button"
      class="open"
      data-m-open
      aria-haspopup="dialog"
      aria-controls="m-menu"
      aria-label="Abrir as seções"
    >
      <span class="where" data-m-where>
        Seções
      </span>
      <Icon name="menu" />
    </button>
  </div>
</header>

<PhoneSheet id="m-menu" title="Seções">
  <nav aria-label="Seções">
    {phoneSections.map((s) => (
      <a href={`#${s.id}`} data-m-link={s.id}>
        <b>{s.label}</b>
        <span>{s.hint}</span>
      </a>
    ))}
  </nav>
  <div class="sheet-actions">
    <PhoneActions release={Astro.props.release} />
  </div>
</PhoneSheet>

<script>
  import "./phone-header.client";
</script>

<style>
  .m-header {
    position: fixed;
    inset: calc(env(safe-area-inset-top, 0px) + 8px) 0 auto;
    z-index: 40;
    padding-inline: max(10px, env(safe-area-inset-left, 0px));
    pointer-events: none;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    padding: 0 6px 0 16px;
    border: 1px solid color-mix(in srgb, var(--ink) 8%, transparent);
    border-radius: var(--radius-pill);
    background: var(--glass-soft);
    box-shadow:
      0 1px 0 var(--glass) inset,
      var(--shadow-sm);
    backdrop-filter: saturate(1.6) blur(16px);
    -webkit-backdrop-filter: saturate(1.6) blur(16px);
    pointer-events: auto;
    transition:
      background-color 0.35s,
      border-color 0.35s,
      color 0.35s;
  }

  .m-header:global(.is-stuck) .bar {
    border-color: color-mix(in srgb, var(--ink) 12%, transparent);
    background: var(--glass-strong);
  }

  .m-header:global(.on-dark) .bar {
    border-color: color-mix(in srgb, var(--night-fg) 12%, transparent);
    background: color-mix(in srgb, var(--night-2) 78%, transparent);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--night-fg) 8%, transparent) inset;
    color: var(--night-fg);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font: 500 var(--text-xl)/1 var(--font-display);
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
    transition: color 0.35s;
  }

  .brand :global(.logo) {
    width: 28px;
    height: 28px;
  }

  .open {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 14px 0 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--paper);
    color: var(--ink);
    font: 500 var(--text-md)/1 var(--font-display);
    cursor: pointer;
    transition:
      background-color 0.35s,
      border-color 0.35s,
      color 0.35s;
    -webkit-tap-highlight-color: transparent;
  }

  .open :global(.icon) {
    width: 18px;
    height: 18px;
  }

  .where {
    display: inline-block;
  }

  /* o nome da seção troca com um passo curto para cima */
  .where:global(.swap) {
    animation: m-header-swap 0.32s var(--ease-out);
  }

  .m-header:global(.on-dark) .brand,
  .m-header:global(.on-dark) .open {
    color: var(--night-fg);
  }

  .m-header:global(.on-dark) .brand {
    --logo-frame: var(--night-fg);
  }

  .m-header:global(.on-dark) .open {
    border-color: var(--night-line);
    background: var(--night-2);
  }

  @keyframes m-header-swap {
    from {
      opacity: 0;
      translate: 0 6px;
    }
  }

  /* ---- seções, dentro da folha ---- */
  nav {
    display: grid;
    margin-top: 4px;
  }

  nav a {
    display: grid;
    gap: 4px;
    padding: 11px 8px;
    border-top: 1px solid var(--line);
    border-radius: 4px;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  nav a:first-child {
    border-top: 0;
  }

  nav b {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 500 var(--text-xl)/1.1 var(--font-display);
    color: var(--ink);
  }

  nav span {
    font-size: var(--text-md);
    line-height: 1.3;
    color: var(--faint);
  }

  /* a seção em que a pessoa está ganha a marca verde */
  nav a[aria-current="true"] b::after {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--signal-hi);
    content: "";
  }

  .sheet-actions {
    margin-top: 12px;
  }

  /* telas baixas: cabeçalho mais baixo (o --m-top de PhoneSite acompanha) e lista mais junta */
  @media (max-height: 620px) {
    .bar {
      height: 48px;
    }

    .open {
      height: 40px;
    }

    nav a {
      padding-block: 6px;
    }
  }
</style>
