---
/**
 * Cabeçalho do celular: o logo e um botão que mostra em que seção a pessoa está. Tocar nele
 * abre a folha de baixo com as seções e os botões de baixar, como num app.
 */
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import Logo from "@/components/ui/Logo.astro";
import { phoneSections } from "@/data/phone";
import { formatSize } from "@/lib/format";
import type { Release } from "@/lib/release";
import ShareButton from "./ShareButton.astro";

interface Props {
  release: Release;
}

const { installer } = Astro.props.release;
---

<header class="m-header" data-m-header>
  <div class="bar">
    <a class="brand" href="#m-abertura" aria-label="CoreBi, início">
      <Logo />
      CoreBi
    </a>
    <button
      type="button"
      class="open"
      data-m-open
      aria-haspopup="dialog"
      aria-controls="m-menu"
      aria-label="Abrir as seções"
    >
      <span class="where" data-m-where>
        Seções
      </span>
      <Icon name="menu" />
    </button>
  </div>
</header>

<dialog id="m-menu" class="sheet" aria-labelledby="m-menu-title" data-m-sheet>
  <div class="grip" aria-hidden="true"></div>
  <div class="sheet-head">
    <h2 id="m-menu-title">Seções</h2>
    <button type="button" class="close" data-m-close aria-label="Fechar">
      <Icon name="close" />
    </button>
  </div>
  <nav aria-label="Seções">
    {phoneSections.map((s) => (
      <a href={`#${s.id}`} data-m-link={s.id}>
        <b>{s.label}</b>
        <span>{s.hint}</span>
      </a>
    ))}
  </nav>
  <div class="sheet-actions">
    <ShareButton />
    <Button
      href={installer.url}
      variant="line"
      icon="download"
      aria-label={`Baixar para Windows, ${formatSize(installer.sizeBytes)}`}
    >
      Baixar
    </Button>
  </div>
</dialog>

<script>
  import "./phone-header.client";
</script>

<style>
  .m-header {
    position: fixed;
    inset: calc(env(safe-area-inset-top, 0px) + 8px) 0 auto;
    z-index: 40;
    padding-inline: max(10px, env(safe-area-inset-left, 0px));
    pointer-events: none;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    padding: 0 6px 0 16px;
    border: 1px solid color-mix(in srgb, var(--ink) 8%, transparent);
    border-radius: var(--radius-pill);
    background: var(--glass-soft);
    box-shadow:
      0 1px 0 var(--glass) inset,
      var(--shadow-sm);
    backdrop-filter: saturate(1.6) blur(16px);
    -webkit-backdrop-filter: saturate(1.6) blur(16px);
    pointer-events: auto;
    transition:
      background-color 0.35s,
      border-color 0.35s,
      color 0.35s;
  }

  .m-header:global(.is-stuck) .bar {
    border-color: color-mix(in srgb, var(--ink) 12%, transparent);
    background: var(--glass-strong);
  }

  .m-header:global(.on-dark) .bar {
    border-color: color-mix(in srgb, var(--night-fg) 12%, transparent);
    background: color-mix(in srgb, var(--night-2) 78%, transparent);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--night-fg) 8%, transparent) inset;
    color: var(--night-fg);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font: 500 var(--text-xl)/1 var(--font-display);
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
    transition: color 0.35s;
  }

  .brand :global(.logo) {
    width: 28px;
    height: 28px;
  }

  .open {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 14px 0 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--paper);
    color: var(--ink);
    font: 500 var(--text-md)/1 var(--font-display);
    cursor: pointer;
    transition:
      background-color 0.35s,
      border-color 0.35s,
      color 0.35s;
    -webkit-tap-highlight-color: transparent;
  }

  .open :global(.icon) {
    width: 18px;
    height: 18px;
  }

  .where {
    display: inline-block;
  }

  /* o nome da seção troca com um passo curto para cima */
  .where:global(.swap) {
    animation: m-header-swap 0.32s var(--ease-out);
  }

  .m-header:global(.on-dark) .brand,
  .m-header:global(.on-dark) .open {
    color: var(--night-fg);
  }

  .m-header:global(.on-dark) .brand {
    --logo-frame: var(--night-fg);
  }

  .m-header:global(.on-dark) .open {
    border-color: var(--night-line);
    background: var(--night-2);
  }

  @keyframes m-header-swap {
    from {
      opacity: 0;
      translate: 0 6px;
    }
  }

  /* ---- folha de baixo ---- */
  .sheet {
    position: fixed;
    inset: auto 0 0;
    width: 100%;
    max-width: 560px;
    max-height: calc(100svh - 24px);
    margin: auto auto 0;
    padding: 8px 16px calc(env(safe-area-inset-bottom, 0px) + 16px);
    overflow-y: auto;
    border: 0;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    background: var(--paper);
    color: var(--text);
    box-shadow: 0 -12px 40px -12px rgb(15 26 32 / 30%);
    transform: translateY(100%);
    transition:
      transform 0.36s var(--ease-out),
      overlay 0.36s allow-discrete,
      display 0.36s allow-discrete;
  }

  .sheet[open] {
    transform: none;
  }

  @starting-style {
    .sheet[open] {
      transform: translateY(100%);
    }
  }

  .sheet::backdrop {
    background: rgb(15 26 32 / 0%);
    transition:
      background-color 0.36s,
      overlay 0.36s allow-discrete,
      display 0.36s allow-discrete;
  }

  .sheet[open]::backdrop {
    background: rgb(15 26 32 / 40%);
  }

  @starting-style {
    .sheet[open]::backdrop {
      background: rgb(15 26 32 / 0%);
    }
  }

  .grip {
    width: 40px;
    height: 4px;
    margin: 0 auto 8px;
    border-radius: var(--radius-pill);
    background: var(--line-2);
  }

  .sheet-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 0 8px 8px;
  }

  .sheet-head h2 {
    margin: 0;
    font: 500 var(--text-2xl)/1 var(--font-display);
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: var(--tint);
    color: var(--ink);
    cursor: pointer;
  }

  .close :global(.icon) {
    width: 18px;
    height: 18px;
  }

  nav {
    display: grid;
    margin-top: 4px;
  }

  nav a {
    display: grid;
    gap: 4px;
    padding: 14px 8px;
    border-top: 1px solid var(--line);
    border-radius: 4px;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  nav a:first-child {
    border-top: 0;
  }

  nav b {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 500 var(--text-xl)/1.1 var(--font-display);
    color: var(--ink);
  }

  nav span {
    font-size: var(--text-md);
    line-height: 1.3;
    color: var(--faint);
  }

  /* a seção em que a pessoa está ganha a marca verde */
  nav a[aria-current="true"] b::after {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--signal-hi);
    content: "";
  }

  /* os mesmos dois botões da abertura, lado a lado, para a folha caber na tela */
  .sheet-actions {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 10px;
    margin-top: 12px;
  }

  .sheet-actions > :global(*) {
    width: 100%;
    padding-inline: 16px;
  }

  @media (max-width: 359px) {
    .sheet-actions {
      grid-template-columns: 1fr;
    }
  }

  :global(html:has(.sheet[open])) {
    overflow: hidden;
  }
</style>
