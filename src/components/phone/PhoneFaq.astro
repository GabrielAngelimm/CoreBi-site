---
/**
 * Perguntas frequentes, no celular. São <details> com o mesmo `name`, então o próprio navegador
 * deixa uma aberta de cada vez. A altura anima onde o navegador sabe animar até "auto"; nos
 * outros, a resposta só abre.
 */
import Icon from "@/components/ui/Icon.astro";
import { site } from "@/config/site";
import { faq } from "@/data/faq";
import { emphasis } from "@/lib/format";
import PhoneSection from "./PhoneSection.astro";
---

<PhoneSection id="m-perguntas" name="Perguntas" label="m-faq-title">
  <h2 id="m-faq-title" class="h2">
    Perguntas frequentes
  </h2>
  <p class="lead">
    Não achou a resposta?{" "}
    <a href={site.links.issues} target="_blank" rel="noopener">
      Abra uma issue no GitHub
    </a>
    .
  </p>

  <div class="list">
    {faq.map((item) => (
      <details name="m-faq">
        <summary>
          {item.question}
          <span class="toggle" aria-hidden="true">
            <Icon name="plus" />
          </span>
        </summary>
        <div class="answer">
          {item.answer.map((paragraph) => (
            <p set:html={emphasis(paragraph)} />
          ))}
        </div>
      </details>
    ))}
  </div>
</PhoneSection>

<style>
  .lead a {
    color: var(--signal-text);
    font-weight: 500;
    text-decoration: none;
  }

  .list {
    margin-top: 20px;
    border-bottom: 1px solid var(--line);
  }

  details {
    border-top: 1px solid var(--line);
    interpolate-size: allow-keywords;
  }

  summary {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 0;
    color: var(--ink);
    font: 500 var(--text-lg)/1.3 var(--font-display);
    list-style: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .toggle {
    display: grid;
    flex: none;
    place-items: center;
    width: 32px;
    height: 32px;
    margin-left: auto;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--paper);
    color: var(--muted);
    transition:
      rotate 0.45s cubic-bezier(0.34, 1.5, 0.64, 1),
      background-color 0.25s,
      color 0.25s,
      border-color 0.25s;
  }

  .toggle :global(svg) {
    width: 14px;
    height: 14px;
  }

  details[open] .toggle {
    rotate: 135deg;
    border-color: var(--ink);
    background: var(--ink);
    color: var(--on-ink);
  }

  /* a resposta abre e fecha deslizando, onde o navegador anima a altura até "auto" */
  details::details-content {
    height: 0;
    overflow: clip;
    opacity: 0;
    transition:
      height 0.36s cubic-bezier(0.45, 0, 0.2, 1),
      opacity 0.36s,
      content-visibility 0.36s allow-discrete;
  }

  details[open]::details-content {
    height: auto;
    opacity: 1;
  }

  .answer {
    padding: 0 0 20px;
    color: var(--muted);
    font-size: var(--text-base);
    line-height: 1.6;
  }

  .answer p {
    margin: 0 0 10px;
  }

  .answer p:last-child {
    margin: 0;
  }

  .answer :global(b) {
    color: var(--ink);
    font-weight: 500;
  }

  @media (max-height: 620px) {
    summary {
      padding-block: 10px;
    }
  }

  @media (max-width: 340px) and (max-height: 620px) {
    summary {
      font-size: var(--text-base);
    }
  }
</style>
